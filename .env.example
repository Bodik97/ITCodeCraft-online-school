# Скопіюй у `.env` і заповни значення. `.env` не комітиться.

# --- Telegram (форми: помилки + успішні заявки) ---
# Токен від @BotFather. Chat ID — особистий чат або група (бот має бути доданий).
# Увага: PUBLIC_* потрапляють у клієнтський бандл. Для секретності — proxy на сервері.
PUBLIC_TELEGRAM_BOT_TOKEN=
PUBLIC_TELEGRAM_CHAT_ID=

# --- Google Apps Script (ліди → Google Sheet) ---
PUBLIC_GOOGLE_SCRIPT_URL=

# --- Analytics ---
# Один GTM на весь сайт. Якщо порожньо — GTM не вантажиться.
# У проді також задається в .github/workflows/deploy.yml.
PUBLIC_GTM_ID=

# Google Ads conversion send_to per page (формат AW-XXXX/label).
# Порожньо = conversion з цієї сторінки не стріляє.
PUBLIC_GOOGLE_ADS_SEND_TO_MAIN=
PUBLIC_GOOGLE_ADS_SEND_TO_ROBLOX=
PUBLIC_GOOGLE_ADS_SEND_TO_FRONTEND=
PUBLIC_GOOGLE_ADS_SEND_TO_SCRATCH=
PUBLIC_GOOGLE_ADS_SEND_TO_MINECRAFT=
