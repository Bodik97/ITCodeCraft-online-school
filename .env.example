# Трекінг взаємодій (кліки, page_view) на зовнішній endpoint (напр. Google Apps Script) вимкнено в Layout.

# Google Tag Manager container ID (публічний). Якщо порожньо — GTM (GA4 + Google Ads + cta_click) не вантажиться.
# У проді задається в .github/workflows/deploy.yml на кроці build.
PUBLIC_GTM_ID=

# Meta (Facebook) Pixel ID. Якщо порожньо — піксель не вантажиться. Подія Lead шлеться на успіх форми.
PUBLIC_FB_PIXEL_ID=
