---
import "@/styles/global.css";
import "@/styles/minecraft/theme.css";
import data from "@/data/minecraft.json";
import BaseLandingLayout from "@/layouts/BaseLandingLayout.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
}

const {
  title = data.meta.title,
  description = data.meta.description,
  lang = data.meta.lang,
  canonicalUrl = data.meta.canonical,
} = Astro.props;

const adsSendTo = import.meta.env.PUBLIC_GOOGLE_ADS_SEND_TO_MINECRAFT?.trim();

const site = Astro.site;
if (!site) throw new Error("Set `site` in astro.config for canonical URLs.");
const canonical = new URL(canonicalUrl, site).href.replace(/\/+$/, "") + "/";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Курс Minecraft для дітей",
  description,
  inLanguage: lang,
  provider: {
    "@type": "EducationalOrganization",
    name: `${data.brand.primary}${data.brand.accent}`,
    url: new URL("/", canonical).href,
  },
});
---

<BaseLandingLayout
  pageGroup="minecraft"
  adsSendTo={adsSendTo}
  title={title}
  description={description}
  lang={lang}
  canonicalUrl={canonicalUrl}
  bodyClass="minecraft-site"
  fontsHref="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fredoka:wght@400;600;700&display=swap"
  revealSelector=".mc-reveal"
  progressCssVar="--mc-progress"
  progressBarClass="mc-scroll-progress"
  skipLinkFocusClass="focus:text-[#3a7d20]"
  jsonLd={jsonLd}
  productName={data.crm.productName}
>
  <slot />
</BaseLandingLayout>
