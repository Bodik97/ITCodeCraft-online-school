---
import "@/styles/global.css";
import data from "@/data/minecraft.json";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
}

const {
  title = data.meta.title,
  description = data.meta.description,
  lang = data.meta.lang,
  canonicalUrl = data.meta.canonical,
} = Astro.props;

const site = Astro.site;
if (!site) throw new Error("Set `site` in astro.config for canonical URLs.");

const canonical = new URL(canonicalUrl, site).href.replace(/\/+$/, "") + "/";
const ogImage = new URL("/assets/OGP/fb.png", canonical).href;

const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Курс Minecraft для дітей",
  description,
  inLanguage: lang,
  provider: {
    "@type": "EducationalOrganization",
    name: `${data.brand.primary}${data.brand.accent}`,
    url: new URL("/", canonical).href,
  },
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono&family=Fredoka:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Outfit:wght@300;900&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon/favicon-32x32.png"
    />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png" />

    <script is:inline type="application/ld+json" set:html={organizationJsonLd} />
    <script is:inline define:vars={{ productName: data.crm.productName }}>
      window.productName = productName;
    </script>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18135456615"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "AW-18135456615");
    </script>
  </head>
  <body class="minecraft-site min-h-dvh flex flex-col antialiased">
    <div class="mc-scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:p-4 focus:bg-white focus:z-[100] focus:text-[#3a7d20] focus:font-bold"
    >
      Перейти до головного контенту
    </a>
    <slot />

    <script>
      const progress = document.getElementById("scroll-progress");
      const onScroll = () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        const pct = h > 0 ? (window.scrollY / h) * 100 : 0;
        if (progress) progress.style.setProperty("--mc-progress", `${pct}%`);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const items = document.querySelectorAll<HTMLElement>(".mc-reveal");
      if (prefersReduced) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      body.minecraft-site {
        font-family: "Inter", sans-serif;
        color: #1f2937;
        background-color: #eaf6e2;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.6) 1px, transparent 1px);
        background-size: 32px 32px;
        overflow-x: hidden;
      }
      body.minecraft-site h1,
      body.minecraft-site h2,
      body.minecraft-site h3 {
        font-family: "Fredoka", sans-serif;
      }

      .mc-scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 4px;
        width: var(--mc-progress, 0%);
        background: linear-gradient(90deg, #5dae3f, #74c043, #fbbf24);
        z-index: 90;
        transition: width 0.1s linear;
      }

      .mc-reveal {
        opacity: 0;
        transform: translateY(24px);
        transition:
          opacity 0.6s ease,
          transform 0.6s cubic-bezier(0.2, 0.65, 0.3, 1);
      }
      .mc-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Blocky Minecraft card: hard offset shadow, squared corners */
      .mc-block {
        border: 2px solid #1f2937;
        box-shadow: 5px 5px 0 0 rgba(31, 41, 55, 0.85);
      }
      .mc-block-sm {
        border: 2px solid #1f2937;
        box-shadow: 3px 3px 0 0 rgba(31, 41, 55, 0.85);
      }

      /* 3D pressable buttons (Minecraft block feel) */
      .mc-btn {
        border: 2px solid #1f2937;
        transition:
          transform 0.1s ease,
          box-shadow 0.1s ease;
      }
      .mc-btn-grass {
        background: #5dae3f;
        color: #0c2912;
        box-shadow: 0 5px 0 0 #2f6b1e;
      }
      .mc-btn-gold {
        background: #fbbf24;
        color: #1f2937;
        box-shadow: 0 5px 0 0 #b8830c;
      }
      .mc-btn:hover {
        transform: translateY(2px);
      }
      .mc-btn-grass:hover {
        box-shadow: 0 3px 0 0 #2f6b1e;
      }
      .mc-btn-gold:hover {
        box-shadow: 0 3px 0 0 #b8830c;
      }
      .mc-btn:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 0 #2f6b1e;
      }

      /* Floating voxel cubes */
      .mc-float {
        animation: mc-float 4s ease-in-out infinite;
      }
      @keyframes mc-float {
        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-14px) rotate(3deg);
        }
      }

      /* Drifting particles in hero */
      .mc-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 1;
      }
      .mc-particle {
        position: absolute;
        border: 2px solid rgba(31, 41, 55, 0.5);
        border-radius: 4px;
        opacity: 0;
        animation: mc-drift linear infinite;
      }
      @keyframes mc-drift {
        0% {
          transform: translateY(0) rotate(0deg);
          opacity: 0;
        }
        12% {
          opacity: 0.85;
        }
        88% {
          opacity: 0.6;
        }
        100% {
          transform: translateY(-115vh) rotate(180deg);
          opacity: 0;
        }
      }

      /* Builds marquee */
      .mc-marquee {
        overflow: hidden;
        mask-image: linear-gradient(
          to right,
          transparent 0%,
          black 8%,
          black 92%,
          transparent 100%
        );
      }
      .mc-marquee-track {
        display: flex;
        gap: 14px;
        width: max-content;
        animation: mc-scroll 30s linear infinite;
      }
      @keyframes mc-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
      .mc-marquee:hover .mc-marquee-track {
        animation-play-state: paused;
      }

      /* Lift on hover for cards */
      .mc-lift {
        transition:
          transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
          box-shadow 0.25s ease;
      }
      .mc-lift:hover {
        transform: translateY(-4px);
        box-shadow: 7px 9px 0 0 rgba(31, 41, 55, 0.85);
      }

      /* Skill bars */
      .mc-bar-fill {
        width: 0;
        transition: width 1.1s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Pixel-art redstone sprites: crisp + gray when off, full colour when on */
      .mc-pixel {
        image-rendering: pixelated;
      }
      .mc-schema-chip img,
      [data-pg-lamp] img {
        filter: grayscale(1) brightness(0.6);
        opacity: 0.7;
        transition:
          filter 0.3s ease,
          opacity 0.3s ease;
      }
      .mc-schema-chip.is-on img,
      [data-pg-lamp].is-on img {
        filter: none;
        opacity: 1;
      }

      /* ---- Game-style animations for the redstone playground ---- */
      .mc-schema-chip {
        will-change: transform, box-shadow;
      }
      .mc-schema-chip.is-on {
        border-color: var(--mc-glow, #fc4a3a) !important;
        animation: mc-glow-pulse 1.6s ease-in-out infinite;
      }
      .mc-schema-chip.just-on img {
        animation: mc-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      [data-conn] {
        transition: background 0.2s ease;
      }
      [data-conn].is-on {
        background: repeating-linear-gradient(
          90deg,
          #fc4a3a 0 4px,
          #7a1410 4px 8px
        );
        background-size: 14px 100%;
        animation: mc-flow 0.45s linear infinite;
      }
      [data-pg-lamp].is-on {
        border-color: #f7b733 !important;
        animation: mc-lamp-glow 1.8s ease-in-out infinite;
      }
      [data-pg-lamp].surge img {
        animation: mc-flicker 0.7s ease-out;
      }
      .mc-spark {
        position: absolute;
        width: 7px;
        height: 7px;
        border-radius: 9999px;
        background: #ffd16b;
        box-shadow: 0 0 8px #ffb733;
        pointer-events: none;
        z-index: 5;
        animation: mc-spark-fly 0.7s ease-out forwards;
      }
      .mc-stage-shake {
        animation: mc-shake 0.4s ease-in-out;
      }
      .mc-pg-btn:active {
        transform: scale(0.94);
      }

      @keyframes mc-pop {
        0% {
          transform: scale(1);
        }
        45% {
          transform: scale(1.28) rotate(-3deg);
        }
        100% {
          transform: scale(1);
        }
      }
      @keyframes mc-glow-pulse {
        0%,
        100% {
          box-shadow: 0 0 8px var(--mc-glow, #fc4a3a);
        }
        50% {
          box-shadow: 0 0 22px var(--mc-glow, #fc4a3a);
        }
      }
      @keyframes mc-flow {
        from {
          background-position: 0 0;
        }
        to {
          background-position: 14px 0;
        }
      }
      @keyframes mc-lamp-glow {
        0%,
        100% {
          box-shadow: 0 0 26px 4px rgba(243, 156, 18, 0.55);
        }
        50% {
          box-shadow: 0 0 48px 12px rgba(243, 156, 18, 0.9);
        }
      }
      @keyframes mc-flicker {
        0% {
          opacity: 0.25;
        }
        10% {
          opacity: 1;
        }
        20% {
          opacity: 0.45;
        }
        32% {
          opacity: 1;
        }
        46% {
          opacity: 0.7;
        }
        60% {
          opacity: 1;
        }
      }
      @keyframes mc-spark-fly {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 1;
        }
        100% {
          transform: translate(var(--tx, 0), var(--ty, 0)) scale(0);
          opacity: 0;
        }
      }
      @keyframes mc-shake {
        0%,
        100% {
          transform: translateX(0);
        }
        20% {
          transform: translateX(-5px);
        }
        40% {
          transform: translateX(5px);
        }
        60% {
          transform: translateX(-3px);
        }
        80% {
          transform: translateX(3px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .mc-schema-chip.is-on,
        .mc-schema-chip.just-on img,
        [data-conn].is-on,
        [data-pg-lamp].is-on,
        [data-pg-lamp].surge img {
          animation: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .mc-reveal,
        .mc-float,
        .mc-particle,
        .mc-marquee-track {
          transition: none;
          animation: none;
        }
        .mc-particle {
          display: none;
        }
        .mc-bar-fill {
          transition: none;
        }
      }
    </style>
  </body>
</html>
