---
// import "../index.css";
import "@/styles/global.css";
import data from "@/data/main.json";
type NotificationItem = {
  name: string;
  action: string;
  time: string;
};

type RuntimeData = {
  notifications: NotificationItem[];
  onlineCount: number;
  openMenuLabel: string;
  closeMenuLabel: string;
  defaultAvatar: string;
};

interface Props {
  lang: string;
  title: string;
  description: string;
  canonicalUrl?: string;
  runtimeData: RuntimeData;
}

const { lang, title, description, runtimeData, canonicalUrl } =
  Astro.props as Props;

const site = Astro.site;
if (!site) {
  throw new Error("Set `site` in astro.config for canonical and sitemap URLs.");
}

const hrefBase = canonicalUrl ?? new URL(Astro.url.pathname, site).href;
const canonical = new URL(hrefBase, site).href.replace(/\/+$/, "") + "/";
const ogImageFb = new URL("/assets/OGP/fb.png", canonical).href;
const ogImageTw = new URL("/assets/OGP/tw.png", canonical).href;

const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: `${data.brand.primary}${data.brand.accent}`,
  url: canonical,
  description,
  inLanguage: lang,
  logo: new URL("/assets/favicon/android-chrome-512x512.png", canonical).href,
  email: data.footerSection.email,
  telephone: data.footerSection.linkPhone.replace("tel:", ""),
  sameAs: data.footerSection.socialLinks.map((link) => link.url),
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: String(data.reviewsSection.reviews.length),
    bestRating: "5",
    worstRating: "1",
  },
  review: data.reviewsSection.reviews.slice(0, 5).map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
    reviewBody: r.text,
  })),
});

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono&family=Fredoka:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Outfit:wght@300;900&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageFb} />
    <meta property="og:locale" content="uk_UA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageTw} />

    <script type="application/ld+json" set:html={organizationJsonLd} />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="./assets/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="./assets/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="./assets/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="./assets/favicon/site.webmanifest" />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18135456615"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "AW-18135456615");
    </script>
  </head>
  <body
    class="min-h-screen bg-paper text-ink selection:bg-neon-cyan/20 selection:text-ink"
  >
    <slot />

    <script
      is:inline
      id="dynamic-data"
      type="application/json"
      set:html={JSON.stringify(runtimeData)}
    />

    <script is:inline>
      const dynamicDataNode = document.getElementById("dynamic-data");
      const dynamicData = dynamicDataNode
        ? JSON.parse(dynamicDataNode.textContent || "{}")
        : {};

      const header = document.getElementById("site-header");
      const headerScrolledClass = "is-scrolled";
      const syncHeader = () => {
        if (!header) return;
        if (window.scrollY > 50) {
          header.classList.add(headerScrolledClass);
        } else {
          header.classList.remove(headerScrolledClass);
        }
      };
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      const mobileMenu = document.getElementById("mobile-menu");
      const mobileToggle = document.getElementById("mobile-menu-toggle");
      const menuIconOpen = document.getElementById("menu-icon-open");
      const menuIconClose = document.getElementById("menu-icon-close");
      const closeMobileMenu = () => {
        if (!mobileMenu || !mobileToggle) return;
        mobileMenu.classList.remove("is-open");
        mobileToggle.setAttribute("aria-expanded", "false");
        mobileToggle.setAttribute(
          "aria-label",
          dynamicData.openMenuLabel || "",
        );
        menuIconOpen?.classList.remove("hidden");
        menuIconClose?.classList.add("hidden");
      };

      mobileToggle?.addEventListener("click", () => {
        if (!mobileMenu || !mobileToggle) return;
        const shouldOpen = !mobileMenu.classList.contains("is-open");
        if (shouldOpen) {
          mobileMenu.classList.add("is-open");
          mobileToggle.setAttribute("aria-expanded", "true");
          mobileToggle.setAttribute(
            "aria-label",
            dynamicData.closeMenuLabel || "",
          );
          menuIconOpen?.classList.add("hidden");
          menuIconClose?.classList.remove("hidden");
        } else {
          closeMobileMenu();
        }
      });

      mobileMenu?.querySelectorAll("a").forEach((node) => {
        node.addEventListener("click", closeMobileMenu);
      });

      document
        .querySelector("[data-close-urgency]")
        ?.addEventListener("click", () => {
          document.getElementById("urgency-banner")?.remove();
        });

      const typingItems = Array.from(
        document.querySelectorAll(".hero-typing-item"),
      );
      let typingIndex = 0;
      if (typingItems.length > 1) {
        window.setInterval(() => {
          typingItems[typingIndex]?.classList.remove("is-active");
          typingIndex = (typingIndex + 1) % typingItems.length;
          typingItems[typingIndex]?.classList.add("is-active");
        }, 2800);
      }
    </script>

    <script is:inline>
      (typeof requestIdleCallback === "function"
        ? requestIdleCallback
        : (fn) => setTimeout(fn, 200))(function () {
        const dynamicDataNode = document.getElementById("dynamic-data");
        const dynamicData = dynamicDataNode
          ? JSON.parse(dynamicDataNode.textContent || "{}")
          : {};

        const notifications = Array.isArray(dynamicData.notifications)
          ? dynamicData.notifications
          : [];
        const notificationRoot = document.getElementById("signup-notification");
        const notificationAvatar = document.getElementById(
          "notification-avatar",
        );
        const notificationName = document.getElementById("notification-name");
        const notificationAction = document.getElementById(
          "notification-action",
        );
        const notificationTime = document.getElementById("notification-time");

        const renderNotification = (item) => {
          if (
            !notificationRoot ||
            !notificationName ||
            !notificationAction ||
            !notificationTime ||
            !notificationAvatar
          )
            return;
          notificationName.textContent = item.name || "";
          notificationAction.textContent = item.action || "";
          notificationTime.innerHTML = `<span aria-hidden="true">✔</span> ${item.time || ""}`;
          notificationAvatar.textContent = (
            item.name ||
            dynamicData.defaultAvatar ||
            ""
          ).charAt(0);
          notificationRoot.classList.remove("is-hidden");
          notificationRoot.classList.add("is-visible");
        };

        const hideNotification = () => {
          if (!notificationRoot) return;
          notificationRoot.classList.remove("is-visible");
          notificationRoot.classList.add("is-hidden");
        };

        const runNotifications = () => {
          if (!notifications.length) return;
          const item =
            notifications[Math.floor(Math.random() * notifications.length)];
          renderNotification(item);
          window.setTimeout(() => {
            hideNotification();
            const nextDelay =
              Math.floor(Math.random() * (5 * 60 * 1000 - 60 * 1000 + 1)) +
              60 * 1000;
            window.setTimeout(runNotifications, nextDelay);
          }, 4000);
        };

        window.setTimeout(runNotifications, 5000);
      });
    </script>
  </body>
</html>
