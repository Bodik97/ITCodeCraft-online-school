---
// import "../index.css";
import "@/styles/global.css";
import data from "@/data/main.json";
type NotificationItem = {
  name: string;
  action: string;
  time: string;
};

type RuntimeData = {
  notifications: NotificationItem[];
  onlineCount: number;
  openMenuLabel: string;
  closeMenuLabel: string;
  defaultAvatar: string;
};

interface Props {
  lang: string;
  title: string;
  description: string;
  canonicalUrl?: string;
  runtimeData: RuntimeData;
}

const { lang, title, description, runtimeData, canonicalUrl } =
  Astro.props as Props;

const site = Astro.site;
if (!site) {
  throw new Error("Set `site` in astro.config for canonical and sitemap URLs.");
}

const hrefBase = canonicalUrl ?? new URL(Astro.url.pathname, site).href;
const canonical = new URL(hrefBase, site).href.replace(/\/+$/, "") + "/";
const ogImageFb = new URL("/assets/OGP/fb.png", canonical).href;
const ogImageTw = new URL("/assets/OGP/tw.png", canonical).href;

const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: `${data.brand.primary}${data.brand.accent}`,
  url: canonical,
  description,
  inLanguage: lang,
  logo: new URL("/assets/favicon/android-chrome-512x512.png", canonical).href,
  email: data.footerSection.email,
  telephone: data.footerSection.linkPhone.replace("tel:", ""),
  sameAs: data.footerSection.socialLinks.map((link) => link.url),
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: String(data.reviewsSection.reviews.length),
    bestRating: "5",
    worstRating: "1",
  },
  review: data.reviewsSection.reviews.slice(0, 5).map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
    reviewBody: r.text,
  })),
});

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          // Default to dark mode; only switch to light if the user explicitly chose it.
          if (localStorage.getItem("itcc-theme") === "light")
            document.documentElement.classList.add("light");
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono&family=Fredoka:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Outfit:wght@300;900&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageFb} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="uk_UA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageTw} />

    <script is:inline type="application/ld+json" set:html={organizationJsonLd} />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="./assets/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="./assets/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="./assets/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="./assets/favicon/site.webmanifest" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-NB6DC34X");
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body
    class="min-h-screen bg-paper text-ink selection:bg-neon-cyan/20 selection:text-ink"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NB6DC34X"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <div class="page-margin-line" aria-hidden="true"></div>
    <slot />

    <script
      is:inline
      id="dynamic-data"
      type="application/json"
      set:html={JSON.stringify(runtimeData)}
    />

    <script is:inline>
      const dynamicDataNode = document.getElementById("dynamic-data");
      const dynamicData = dynamicDataNode
        ? JSON.parse(dynamicDataNode.textContent || "{}")
        : {};

      const header = document.getElementById("site-header");
      const headerScrolledClass = "is-scrolled";
      const syncHeader = () => {
        if (!header) return;
        if (window.scrollY > 50) {
          header.classList.add(headerScrolledClass);
        } else {
          header.classList.remove(headerScrolledClass);
        }
      };
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      const mobileMenu = document.getElementById("mobile-menu");
      const mobileToggle = document.getElementById("mobile-menu-toggle");
      const menuIconOpen = document.getElementById("menu-icon-open");
      const menuIconClose = document.getElementById("menu-icon-close");
      const closeMobileMenu = () => {
        if (!mobileMenu || !mobileToggle) return;
        mobileMenu.classList.remove("is-open");
        mobileToggle.setAttribute("aria-expanded", "false");
        mobileToggle.setAttribute(
          "aria-label",
          dynamicData.openMenuLabel || "",
        );
        menuIconOpen?.classList.remove("hidden");
        menuIconClose?.classList.add("hidden");
      };

      mobileToggle?.addEventListener("click", () => {
        if (!mobileMenu || !mobileToggle) return;
        const shouldOpen = !mobileMenu.classList.contains("is-open");
        if (shouldOpen) {
          mobileMenu.classList.add("is-open");
          mobileToggle.setAttribute("aria-expanded", "true");
          mobileToggle.setAttribute(
            "aria-label",
            dynamicData.closeMenuLabel || "",
          );
          menuIconOpen?.classList.add("hidden");
          menuIconClose?.classList.remove("hidden");
        } else {
          closeMobileMenu();
        }
      });

      mobileMenu?.querySelectorAll("a").forEach((node) => {
        node.addEventListener("click", closeMobileMenu);
      });

      document
        .querySelector("[data-close-urgency]")
        ?.addEventListener("click", () => {
          document.getElementById("urgency-banner")?.remove();
        });

      const typingItems = Array.from(
        document.querySelectorAll(".hero-typing-item"),
      );
      let typingIndex = 0;
      if (typingItems.length > 1) {
        window.setInterval(() => {
          typingItems[typingIndex]?.classList.remove("is-active");
          typingIndex = (typingIndex + 1) % typingItems.length;
          typingItems[typingIndex]?.classList.add("is-active");
        }, 2800);
      }
    </script>

    <script is:inline>
      (typeof requestIdleCallback === "function"
        ? requestIdleCallback
        : (fn) => setTimeout(fn, 200))(function () {
        const dynamicDataNode = document.getElementById("dynamic-data");
        const dynamicData = dynamicDataNode
          ? JSON.parse(dynamicDataNode.textContent || "{}")
          : {};

        const notifications = Array.isArray(dynamicData.notifications)
          ? dynamicData.notifications
          : [];
        const notificationRoot = document.getElementById("signup-notification");
        const notificationAvatar = document.getElementById(
          "notification-avatar",
        );
        const notificationName = document.getElementById("notification-name");
        const notificationAction = document.getElementById(
          "notification-action",
        );
        const notificationTime = document.getElementById("notification-time");

        const renderNotification = (item) => {
          if (
            !notificationRoot ||
            !notificationName ||
            !notificationAction ||
            !notificationTime ||
            !notificationAvatar
          )
            return;
          notificationName.textContent = item.name || "";
          notificationAction.textContent = item.action || "";
          notificationTime.innerHTML = `<span aria-hidden="true">✔</span> ${item.time || ""}`;
          notificationAvatar.textContent = (
            item.name ||
            dynamicData.defaultAvatar ||
            ""
          ).charAt(0);
          notificationRoot.classList.remove("is-hidden");
          notificationRoot.classList.add("is-visible");
        };

        const hideNotification = () => {
          if (!notificationRoot) return;
          notificationRoot.classList.remove("is-visible");
          notificationRoot.classList.add("is-hidden");
        };

        const runNotifications = () => {
          if (!notifications.length) return;
          const item =
            notifications[Math.floor(Math.random() * notifications.length)];
          renderNotification(item);
          window.setTimeout(() => {
            hideNotification();
            const nextDelay =
              Math.floor(Math.random() * (5 * 60 * 1000 - 60 * 1000 + 1)) +
              60 * 1000;
            window.setTimeout(runNotifications, nextDelay);
          }, 4000);
        };

        window.setTimeout(runNotifications, 5000);
      });
    </script>

    <script is:inline>
      document
        .getElementById("theme-toggle")
        ?.addEventListener("click", function () {
          var isLight = document.documentElement.classList.toggle("light");
          try {
            localStorage.setItem("itcc-theme", isLight ? "light" : "dark");
          } catch (e) {}
        });
    </script>

    <script>
      import { initCarousels } from "@/scripts/carousel";
      initCarousels();
    </script>

    <style is:global>
      /* Dark (default): notebook grid on the page background, matches hero .bg-grid (40px) */
      body:not(.roblox-site) {
        background-image:
          linear-gradient(to right, rgba(148, 163, 184, 0.045) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(148, 163, 184, 0.045) 1px, transparent 1px);
        background-size: 40px 40px;
        background-attachment: scroll;
      }
      /* Left "поля" margin line aligned to the widest content column */
      .page-margin-line {
        position: fixed;
        top: 0;
        bottom: 0;
        left: max(1rem, calc((100vw - 84rem) / 2));
        width: 2px;
        background: rgba(244, 63, 94, 0.1);
        z-index: -1;
        pointer-events: none;
      }

      /* Theme toggle icons */
      html.light .theme-icon-moon {
        display: none;
      }
      html.light .theme-icon-sun {
        display: block;
      }

      /* Light theme (home only) */
      html.light body:not(.roblox-site) {
        --color-paper: #f4f7fc;
        --color-card: #ffffff;
        --color-ink: #0f172a;
        --color-muted: #64748b;
        --color-line: #e2e8f0;
        --color-surface: #ffffff;
        --color-surface-light: #f1f5f9;
        --color-slate-200: #e2e8f0;
        --color-slate-300: #334155;
        --color-slate-400: #475569;
        --color-slate-500: #64748b;
        --color-slate-600: #475569;
        --color-slate-700: #cbd5e1;
        --color-gray-500: #6b7280;
        --color-gray-600: #4b5563;
        background-color: #f4f7fc;
        color: #0f172a;
        background-image:
          linear-gradient(to right, rgba(100, 116, 139, 0.12) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(100, 116, 139, 0.12) 1px, transparent 1px);
      }
      html.light .header-shell.is-scrolled {
        background: rgba(244, 247, 252, 0.92);
      }
      html.light .page-margin-line {
        background: rgba(244, 63, 94, 0.18);
      }
      html.light .why-benefit-card,
      html.light .sc-card,
      html.light .faq-item {
        box-shadow: 0 14px 30px -18px rgba(15, 23, 42, 0.25);
      }
      /* Footer is hardcoded dark in markup — flip it to light here */
      html.light footer {
        background: #eaeff7 !important;
      }
      /* Soften the bright neon glow shadows that look heavy on a light bg */
      html.light .shadow-neon-cyan,
      html.light .shadow-neon-magenta {
        box-shadow: 0 8px 22px -10px rgba(15, 23, 42, 0.28);
      }
    </style>
  </body>
</html>
