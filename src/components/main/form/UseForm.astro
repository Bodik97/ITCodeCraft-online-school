---
import Form from "./Form.tsx";
import content from "@/data/main.json";

interface Props {
  isModalForm?: boolean;
  formId: string;
}

const { isModalForm = false, formId } = Astro.props;
---

<Form
  client:idle
  formFields={content.registerSection.forms.inputsFields}
  crmParams={{
    product_name: "product_name",
    product_id: "product_id",
    redirectUrl: "",
    isModalForm,
    formId,
  }}
/>
