---
// Site-wide analytics — a single GTM container delivers GA4 + Google Ads for the
// whole site. Gated on PUBLIC_GTM_ID so nothing loads until the container exists.
// `pageGroup` is pushed to the dataLayer BEFORE GTM loads so the GA4 config tag can
// map it to `content_group` → clean per-page reporting.
// Optional `adsSendTo` enables the Google Ads conversion snippet for that page only.
// CTA clicks also go to Telegram via window.itccTrack (ItccTrack.astro).
// NOTE: with `define:vars` the script is inline and its body is raw JS — do NOT wrap
// it in a `{`...`}` template expression (Astro would output that literally).
import GoogleAdsConversion from "@/components/shared/GoogleAdsConversion.astro";
import ItccTrack from "@/components/shared/ItccTrack.astro";

interface Props {
  pageGroup: string;
  adsSendTo?: string;
}
const { pageGroup, adsSendTo } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim();
const conversionSendTo = adsSendTo?.trim() || "";
---
<ItccTrack />
{
  gtmId && (
    <>
      <script is:inline define:vars={{ pageGroup, gtmId }}>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ page_group: pageGroup });

        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", gtmId);
      </script>
      {conversionSendTo && <GoogleAdsConversion sendTo={conversionSendTo} />}
    </>
  )
}
<script is:inline define:vars={{ pageGroup }}>
  // Delegated CTA tracking → dataLayer (GTM). Telegram gets high-intent events
  // via window.itccTrack (modal open, form submit) — not every button click.
  document.addEventListener(
    "click",
    function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var el = t.closest('a,button,[role="button"],[data-cta]');
      if (!el) return;
      var text = (
        el.getAttribute("data-cta") ||
        el.getAttribute("aria-label") ||
        el.textContent ||
        ""
      )
        .replace(/\s+/g, " ")
        .trim()
        .slice(0, 80);
      if (!text) return;
      var sec = el.closest("[data-cta-section]");
      var loc = sec
        ? sec.getAttribute("data-cta-section")
        : el.closest("header")
          ? "header"
          : el.closest("footer")
            ? "footer"
            : (el.closest("section[id]") && el.closest("section[id]").id) ||
              "body";
      var href = el.tagName === "A" ? el.getAttribute("href") || "" : "";
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "cta_click",
        cta_text: text,
        cta_location: loc,
        cta_href: href,
        page_group: pageGroup,
      });
    },
    true,
  );
</script>
