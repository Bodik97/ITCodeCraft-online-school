---
import content from "@/data/main.json";

const fab = content.messengerFab;

interface Props {
  /** Accent colour of the floating toggle, glow and pulse — match the page theme. */
  accent?: string;
  /** Same accent as "r, g, b" for the translucent glow/pulse layers. */
  accentRgb?: string;
  /** Gradient end of the toggle (a darker shade of the accent). */
  accentDark?: string;
  /** Icon colour on the toggle (dark for light accents, white for saturated ones). */
  fg?: string;
  /** Positioning utilities; defaults clear the home page's mobile sticky CTA. */
  position?: string;
}

const {
  accent = "#22d3ee",
  accentRgb = "34, 211, 238",
  accentDark = "#2563eb",
  fg = "#0f172a",
  position = "bottom-24 right-5 sm:right-6 lg:bottom-6",
} = Astro.props;

const rootStyle = `--fab-accent:${accent};--fab-accent-rgb:${accentRgb};--fab-accent-2:${accentDark};--fab-fg:${fg};`;
---

<div
  id="messenger-fab-root"
  class:list={["fixed z-[60] flex flex-col items-end", position]}
  style={rootStyle}
>
  <div class="relative flex flex-col items-end justify-end">
    <div
      id="messenger-fab-panel"
      class="messenger-fab-panel absolute bottom-[calc(100%+12px)] right-0 flex flex-col items-end gap-3"
      role="group"
      aria-label="Месенджери"
      aria-hidden="true"
    >
    <a
      href={fab.viberUrl}
      class="messenger-fab-link flex h-12 w-12 items-center justify-center rounded-full bg-[#7360f2] text-white shadow-lg ring-2 ring-white/15 transition-[transform,filter] duration-200 hover:scale-105 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
      aria-label={fab.viberLabel}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          fill-rule="evenodd"
          d="M16.676 2.628a21.9 21.9 0 0 0-9.555 0l-.339.075a4.9 4.9 0 0 0-3.684 3.58a19.5 19.5 0 0 0 0 9.577a4.9 4.9 0 0 0 3.444 3.52l.465 2.776a.5.5 0 0 0 .826.29l2.731-2.443a22 22 0 0 0 6.112-.487l.34-.075a4.9 4.9 0 0 0 3.684-3.58a19.5 19.5 0 0 0 0-9.577a4.9 4.9 0 0 0-3.685-3.58zM7.965 6.202a.82.82 0 0 0-.537.106h-.014c-.375.22-.713.497-1.001.823c-.24.277-.37.557-.404.827c-.02.16-.006.322.041.475l.018.01c.27.793.622 1.556 1.052 2.274a13.4 13.4 0 0 0 2.03 2.775l.024.034l.038.028l.023.027l.028.024a13.6 13.6 0 0 0 2.782 2.04c1.155.629 1.856.926 2.277 1.05v.006c.123.038.235.055.348.055a1.6 1.6 0 0 0 .964-.414c.325-.288.6-.627.814-1.004v-.007c.201-.38.133-.738-.157-.981A12 12 0 0 0 14.41 13c-.448-.243-.903-.096-1.087.15l-.393.496c-.202.246-.568.212-.568.212l-.01.006c-2.731-.697-3.46-3.462-3.46-3.462s-.034-.376.219-.568l.492-.396c.236-.192.4-.646.147-1.094a12 12 0 0 0-1.347-1.88a.75.75 0 0 0-.44-.263M12.579 5a.5.5 0 0 0 0 1c1.265 0 2.315.413 3.146 1.205c.427.433.76.946.978 1.508c.219.563.319 1.164.293 1.766a.5.5 0 0 0 1 .042a5.4 5.4 0 0 0-.361-2.17a5.4 5.4 0 0 0-1.204-1.854l-.01-.01C15.39 5.502 14.085 5 12.579 5m-.034 1.644a.5.5 0 0 0 0 1h.017c.912.065 1.576.369 2.041.868c.477.514.724 1.153.705 1.943a.5.5 0 0 0 1 .023c.024-1.037-.31-1.932-.972-2.646V7.83c-.677-.726-1.606-1.11-2.724-1.185l-.017-.002zm-.019 1.675a.5.5 0 1 0-.052.998c.418.022.685.148.853.317c.169.17.295.443.318.87a.5.5 0 1 0 .998-.053c-.032-.6-.22-1.13-.605-1.52c-.387-.39-.914-.58-1.512-.612"
          clip-rule="evenodd"></path></svg
      >
    </a>
    <a
      href={fab.telegramUrl}
      class="messenger-fab-link flex h-12 w-12 items-center justify-center rounded-full bg-[#229ED9] text-white shadow-lg ring-2 ring-white/15 transition-[transform,filter] duration-200 hover:scale-105 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
      aria-label={fab.telegramLabel}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2m4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19c-.14.75-.42 1-.68 1.03c-.58.05-1.02-.38-1.58-.75c-.88-.58-1.38-.94-2.23-1.5c-.99-.65-.35-1.01.22-1.59c.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02c-.09.02-1.49.95-4.22 2.79c-.4.27-.76.41-1.08.4c-.36-.01-1.04-.2-1.55-.37c-.63-.2-1.12-.31-1.08-.66c.02-.18.27-.36.74-.55c2.92-1.27 4.86-2.11 5.83-2.51c2.78-1.16 3.35-1.36 3.73-1.36c.08 0 .27.02.39.12c.1.08.13.19.14.27c-.01.06.01.24 0 .38"
        ></path></svg
      >
    </a>
    <a
      href={fab.whatsappUrl}
      class="messenger-fab-link flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg ring-2 ring-white/15 transition-[transform,filter] duration-200 hover:scale-105 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
      aria-label={fab.whatsappLabel}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01m-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18l-3.12.82l.83-3.04l-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81c-.23-.08-.39-.12-.56.12c-.17.25-.64.81-.78.97c-.14.17-.29.19-.54.06c-.25-.12-1.05-.39-1.99-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.14-.25-.02-.38.11-.51c.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74c.59.26 1.05.41 1.41.52c.59.19 1.13.16 1.56.1c.48-.07 1.47-.6 1.67-1.18c.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28"
        ></path></svg
      >
    </a>
  </div>
  </div>

  <div class="relative flex h-14 w-14 shrink-0 items-center justify-center">
    <span
      class="messenger-fab-pulse-ring pointer-events-none absolute inset-[-6px] rounded-full border-2"
      aria-hidden="true"></span>
    <span
      class="messenger-fab-pulse pointer-events-none absolute inset-0 rounded-full"
      aria-hidden="true"></span>
    <button
      type="button"
      id="messenger-fab-toggle"
      class="messenger-fab-toggle relative flex h-14 w-14 shrink-0 items-center justify-center rounded-full transition-[transform,box-shadow] duration-300 ease-out hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      aria-expanded="false"
      aria-controls="messenger-fab-panel"
      aria-label={fab.toggleLabel}
      data-label-open={fab.toggleLabel}
      data-label-close={fab.toggleLabelClose}
    >
      <span
        class="messenger-fab-toggle-icons pointer-events-none relative inline-flex size-7 items-center justify-center"
        aria-hidden="true"
      >
        <svg
          id="messenger-fab-icon-chat"
          class="messenger-fab-icon-chat absolute inset-0 m-auto h-7 w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
          ></path>
        </svg>
        <svg
          id="messenger-fab-icon-close"
          class="messenger-fab-icon-close absolute inset-0 m-auto h-7 w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </span>
    </button>
  </div>
</div>

<style>
  .messenger-fab-pulse {
    background-color: rgba(var(--fab-accent-rgb), 0.35);
    animation: messenger-fab-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .messenger-fab-pulse-ring {
    border-color: rgba(var(--fab-accent-rgb), 0.5);
    animation: messenger-fab-ring 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .messenger-fab-toggle {
    background: linear-gradient(
      135deg,
      var(--fab-accent),
      var(--fab-accent-2)
    );
    color: var(--fab-fg);
    animation: messenger-fab-breathe 2.2s ease-in-out infinite;
  }

  .messenger-fab-link:focus-visible {
    outline-color: var(--fab-accent);
  }

  #messenger-fab-root.is-open .messenger-fab-pulse,
  #messenger-fab-root.is-open .messenger-fab-pulse-ring {
    animation-play-state: paused;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  #messenger-fab-root.is-open .messenger-fab-toggle {
    animation-play-state: paused;
    transform: scale(1);
  }

  .messenger-fab-toggle-icons {
    transform-origin: center;
  }

  .messenger-fab-icon-chat,
  .messenger-fab-icon-close {
    transition:
      opacity 0.32s cubic-bezier(0.32, 0.72, 0, 1),
      transform 0.38s cubic-bezier(0.34, 1.35, 0.64, 1);
    transition-delay: 0s;
    transform-origin: center;
  }

  .messenger-fab-icon-chat {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .messenger-fab-icon-close {
    opacity: 0;
    transform: rotate(-100deg) scale(0.5);
  }

  #messenger-fab-root.is-open .messenger-fab-icon-chat {
    opacity: 0;
    transform: rotate(85deg) scale(0.55);
  }

  #messenger-fab-root.is-open .messenger-fab-icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition-delay: 0.05s;
  }

  .messenger-fab-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(1rem) scale(0.94);
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 0.32s cubic-bezier(0.32, 0.72, 0, 1),
      transform 0.34s cubic-bezier(0.32, 0.72, 0, 1),
      visibility 0.34s;
  }

  .messenger-fab-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .messenger-fab-link {
    opacity: 0;
    transform: translateX(1.25rem) scale(0.88);
    transition:
      opacity 0.28s cubic-bezier(0.32, 0.72, 0, 1),
      transform 0.32s cubic-bezier(0.34, 1.45, 0.64, 1);
  }

  .messenger-fab-panel.is-open .messenger-fab-link:nth-child(1) {
    opacity: 1;
    transform: translateX(0) scale(1);
    transition-delay: 0.06s;
  }

  .messenger-fab-panel.is-open .messenger-fab-link:nth-child(2) {
    opacity: 1;
    transform: translateX(0) scale(1);
    transition-delay: 0.11s;
  }

  .messenger-fab-panel.is-open .messenger-fab-link:nth-child(3) {
    opacity: 1;
    transform: translateX(0) scale(1);
    transition-delay: 0.16s;
  }

  .messenger-fab-panel:not(.is-open) .messenger-fab-link {
    transition-delay: 0s;
  }

  @keyframes messenger-fab-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @keyframes messenger-fab-ring {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    75% {
      transform: scale(1.45);
      opacity: 0;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  @keyframes messenger-fab-breathe {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
      box-shadow:
        inset 0 0 0 2px rgba(var(--fab-accent-rgb), 0.4),
        0 0 20px rgba(var(--fab-accent-rgb), 0.4),
        0 0 32px rgba(var(--fab-accent-rgb), 0.12);
    }
    50% {
      transform: scale(1.04) rotate(0deg);
      box-shadow:
        inset 0 0 0 2px rgba(var(--fab-accent-rgb), 0.5),
        0 0 28px rgba(var(--fab-accent-rgb), 0.55),
        0 0 44px rgba(var(--fab-accent-rgb), 0.2);
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById("messenger-fab-root");
    const panel = document.getElementById("messenger-fab-panel");
    const toggle = document.getElementById("messenger-fab-toggle");

    if (!root || !panel || !toggle) return;

    const openLabel = toggle.getAttribute("data-label-open") || "";
    const closeLabel = toggle.getAttribute("data-label-close") || "";

    const setOpen = (nextOpen) => {
      toggle.setAttribute("aria-expanded", nextOpen ? "true" : "false");
      toggle.setAttribute("aria-label", nextOpen ? closeLabel : openLabel);
      panel.classList.toggle("is-open", nextOpen);
      panel.setAttribute("aria-hidden", nextOpen ? "false" : "true");
      root.classList.toggle("is-open", nextOpen);
    };

    let open = false;

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      open = !open;
      setOpen(open);
    });

    document.addEventListener("click", () => {
      if (!open) return;
      open = false;
      setOpen(false);
    });

    root.addEventListener("click", (e) => e.stopPropagation());

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) {
        open = false;
        setOpen(false);
      }
    });
  })();
</script>
