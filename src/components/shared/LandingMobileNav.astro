---
// Mobile hamburger menu for the landing pages (frontend / minecraft / scratch).
// All colours come in as Tailwind class strings so each page can match its theme.
interface Props {
  links: { id: string; label: string }[];
  /** Classes for the hamburger toggle button (border + icon colour). */
  toggleClass: string;
  /** Classes for the dropdown panel (background + border). */
  panelClass: string;
  /** Classes for each menu link card (background + border + text + hover). */
  linkClass: string;
  /** Colour of the glowing bullet on each link. */
  dotColor: string;
  backUrl: string;
  backLabel: string;
  ctaLabel: string;
  /** Page button classes for the menu CTA (reuses the landing's button style). */
  ctaClass: string;
}

const {
  links,
  toggleClass,
  panelClass,
  linkClass,
  dotColor,
  backUrl,
  backLabel,
  ctaLabel,
  ctaClass,
} = Astro.props;

const dotStyle = `background:${dotColor};box-shadow:0 0 8px ${dotColor}`;
---

<button
  id="lmn-toggle"
  type="button"
  class:list={[
    "lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg border transition-colors",
    toggleClass,
  ]}
  aria-label="Меню"
  aria-expanded="false"
  aria-controls="lmn-panel"
>
  <svg
    id="lmn-icon-open"
    class="size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <svg
    id="lmn-icon-close"
    class="size-5 hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M18 6L6 18M6 6l12 12"></path>
  </svg>
</button>

<div
  id="lmn-panel"
  class:list={[
    "lmn-panel lg:hidden fixed inset-x-3 top-[4.5rem] z-[45] rounded-2xl border p-4 shadow-2xl",
    panelClass,
  ]}
  hidden
>
  <nav class="flex flex-col gap-2">
    {
      links.map((link) => (
        <a
          href={`#${link.id}`}
          class:list={[
            "flex items-center gap-3 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors",
            linkClass,
          ]}
          data-lmn-link
        >
          <span
            class="h-1.5 w-1.5 shrink-0 rounded-full"
            style={dotStyle}
            aria-hidden="true"
          />
          {link.label}
        </a>
      ))
    }
    <a
      href={backUrl}
      class:list={[
        "flex items-center gap-3 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors",
        linkClass,
      ]}
      data-lmn-link
    >
      <span aria-hidden="true">←</span>
      {backLabel}
    </a>
  </nav>
  <button
    type="button"
    data-lead-modal-open
    class:list={[
      "mt-3 w-full inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-bold",
      ctaClass,
    ]}
    data-lmn-link
  >
    {ctaLabel}
  </button>
</div>

<script is:inline>
  (function () {
    const toggle = document.getElementById("lmn-toggle");
    const panel = document.getElementById("lmn-panel");
    const iconOpen = document.getElementById("lmn-icon-open");
    const iconClose = document.getElementById("lmn-icon-close");
    if (!toggle || !panel) return;

    let open = false;
    const setOpen = (next) => {
      open = next;
      panel.toggleAttribute("hidden", !next);
      toggle.setAttribute("aria-expanded", next ? "true" : "false");
      iconOpen?.classList.toggle("hidden", next);
      iconClose?.classList.toggle("hidden", !next);
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!open);
    });
    panel
      .querySelectorAll("[data-lmn-link]")
      .forEach((el) => el.addEventListener("click", () => setOpen(false)));
    document.addEventListener("click", (e) => {
      if (open && !panel.contains(e.target) && e.target !== toggle) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) setOpen(false);
    });
  })();
</script>
