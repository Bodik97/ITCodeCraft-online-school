---
// Mobile-only sticky bottom CTA for the landing pages. Opens the page's LeadModal.
interface Props {
  label: string;
  /** Bar background + top border classes (page surface). */
  barClass: string;
  /** Page button classes (reuses the landing's primary button style). */
  btnClass: string;
}

const { label, barClass, btnClass } = Astro.props;
---

<div
  class:list={[
    "lg:hidden fixed inset-x-0 bottom-0 z-[55] px-4 py-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] backdrop-blur-md",
    barClass,
  ]}
>
  <button
    type="button"
    data-lead-modal-open
    class:list={[
      "w-full inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-bold",
      btnClass,
    ]}
  >
    {label}
    <span aria-hidden="true">→</span>
  </button>
</div>
