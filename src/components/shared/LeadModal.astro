---
import UseForm from "@/components/main/form/UseForm.astro";

interface Props {
  /** Distinct form id for this page's modal lead. */
  formId: string;
  /** Modal heading. */
  title: string;
  /** Page accent (button, focus, glow) — matches the landing theme. */
  accent: string;
  /** Accent as "r, g, b" for translucent glow. */
  accentRgb: string;
  /** Text colour on the accent button. */
  accentFg?: string;
  /** Phone shown in the error message. */
  phone?: string;
}

const {
  formId,
  title,
  accent,
  accentRgb,
  accentFg = "#ffffff",
  phone = "",
} = Astro.props;

const styleVars = `--form-accent:${accent};--form-accent-rgb:${accentRgb};--form-accent-fg:${accentFg};`;
---

<div
  class="lead-modal fixed inset-0 z-[80] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
  data-lead-modal-root
  aria-hidden="true"
  inert
>
  <div
    class="absolute inset-0 bg-[#0a1020]/70 backdrop-blur-sm"
    data-lead-modal-overlay
  >
  </div>

  <div
    class="lead-modal-panel relative z-10 w-full max-w-[480px] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-2xl border border-slate-200/25 bg-surface px-5 py-8 sm:px-7 scale-[0.97] translate-y-4 opacity-0 transition-[transform,opacity] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
    role="dialog"
    aria-modal="true"
    aria-labelledby={`lead-modal-title-${formId}`}
    style={styleVars}
  >
    <button
      type="button"
      class="absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200/30 text-ink/80 transition hover:scale-105"
      style={`color:${accent}`}
      data-lead-modal-close
      aria-label="Закрити вікно"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <h2
      id={`lead-modal-title-${formId}`}
      class="mb-6 pr-10 text-2xl font-bold font-display leading-tight"
      style={`color:${accent}`}
    >
      {title}
    </h2>

    <div data-lead-modal-form>
      <UseForm isModalForm={true} formId={formId} />
    </div>

    <div data-lead-modal-success hidden class="text-center py-6">
      <div class="text-4xl mb-3" aria-hidden="true">🎉</div>
      <h3 class="font-display text-2xl font-bold mb-2 text-ink">
        Чудовий вибір!
      </h3>
      <p class="text-slate-400">
        Ми отримали вашу заявку. Менеджер зателефонує найближчим часом.
      </p>
    </div>

    <p data-lead-modal-error hidden class="mt-4 text-center text-sm font-medium text-[#fca5a5]">
      Сталася помилка. Спробуйте ще раз або зателефонуйте: {phone}
    </p>
  </div>
</div>

<script>
  import { onFormError, onFormSuccess } from "@/lib/formEvents";

  const root = document.querySelector("[data-lead-modal-root]");
  if (root instanceof HTMLElement) {
    const panel = root.querySelector(".lead-modal-panel");
    const formBox = root.querySelector("[data-lead-modal-form]");
    const successBox = root.querySelector("[data-lead-modal-success]");
    const errorBox = root.querySelector("[data-lead-modal-error]");
    const openers = document.querySelectorAll("[data-lead-modal-open]");
    const closers = root.querySelectorAll(
      "[data-lead-modal-close], [data-lead-modal-overlay]",
    );

    const hiddenRoot = ["opacity-0", "pointer-events-none"];
    const hiddenPanel = ["opacity-0", "translate-y-4", "scale-[0.97]"];

    const isClosed = () => hiddenRoot.every((c) => root.classList.contains(c));

    const resetState = () => {
      formBox?.removeAttribute("hidden");
      successBox?.setAttribute("hidden", "");
      errorBox?.setAttribute("hidden", "");
    };

    const open = () => {
      if (!isClosed()) return;
      resetState();
      root.removeAttribute("inert");
      root.setAttribute("aria-hidden", "false");
      root.classList.remove(...hiddenRoot);
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => panel?.classList.remove(...hiddenPanel));
    };

    const close = () => {
      if (isClosed()) return;
      root.classList.add(...hiddenRoot);
      panel?.classList.add(...hiddenPanel);
      root.setAttribute("aria-hidden", "true");
      root.setAttribute("inert", "");
      document.body.style.overflow = "";
    };

    root.classList.add(...hiddenRoot);
    panel?.classList.add(...hiddenPanel);

    openers.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        if (btn instanceof HTMLAnchorElement) e.preventDefault();
        open();
      });
    });
    closers.forEach((btn) => btn.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    onFormSuccess(() => {
      if (isClosed()) return;
      formBox?.setAttribute("hidden", "");
      errorBox?.setAttribute("hidden", "");
      successBox?.removeAttribute("hidden");
    });
    onFormError(() => {
      if (isClosed()) return;
      errorBox?.removeAttribute("hidden");
    });
  }
</script>
