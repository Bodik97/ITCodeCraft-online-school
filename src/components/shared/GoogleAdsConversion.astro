---
// Google Ads event snippet — call window.gtag_report_conversion on lead submit.
// `sendTo` is the conversion label (AW-XXX/label). Omit this component when empty.
interface Props {
  sendTo: string;
}

const { sendTo } = Astro.props;
---
<script is:inline define:vars={{ sendTo }}>
  window.dataLayer = window.dataLayer || [];
  if (typeof window.gtag !== "function") {
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
  }

  window.gtag_report_conversion = function gtag_report_conversion(url) {
    var callback = function () {
      if (typeof url != "undefined") {
        window.location = url;
      }
    };
    window.gtag("event", "conversion", {
      send_to: sendTo,
      event_callback: callback,
    });
    return false;
  };
</script>
