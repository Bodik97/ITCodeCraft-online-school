---
import content from "@/data/data.json";

const fab = content.messengerFab;
---

<div
  id="messenger-fab-root"
  class="fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-3 sm:bottom-6 sm:right-6"
>
  <div
    id="messenger-fab-panel"
    class="messenger-fab-panel flex flex-col items-end gap-3"
    role="group"
    aria-label="Месенджери"
    hidden
  >
    <a
      href={fab.viberUrl}
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#7360f2] text-white shadow-lg ring-2 ring-white/15 transition-transform hover:scale-105 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neon-cyan"
      aria-label={fab.viberLabel}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="currentColor"
      >
        <path
          d="M11.4 0C9.34 0 5.48.25 3.02 2.16 1.1 3.73.26 6.05.06 9.31c-.2 3.26-.45 9.41 5.95 11.13V24l3.42-2.03.02-.01c1.28.36 6.46 2.05 12.1-.21 3.12-1.16 5.3-4.21 5.47-8.85.18-4.92-1.82-8.72-5.58-10.43C18.7.39 15.07 0 11.4 0zm.06 1.47c3.5 0 6.93.38 9.74 1.9 3.25 1.5 4.98 4.86 4.83 9.24-.15 4.1-2.03 6.78-4.76 7.79-5.2 1.94-10.11.32-11.45-.06l-.32-.09-.27.16-2.8 1.66v-2.33l-.57-.15C1.84 17.7 2.06 11.8 2.24 9.38c.18-2.87.92-4.78 2.47-6.02C6.94 1.7 10.45 1.47 11.46 1.47zM7.07 6.5c-.16 0-.36.05-.53.19l-.02.02c-.35.34-.95 1.17-.42 2.42.53 1.22 1.8 2.6 1.8 2.6s.95 1.4 2.43 2.53c1.1.81 2.01 1.08 2.67 1.2.67.12 1.2.05 1.63-.18.5-.26 1.16-.85 1.32-1.65.17-.85-.1-1.55-.48-1.73l-.01-.01c-.35-.17-.83-.47-1.16-.63-.34-.15-.57-.23-.81-.06-.26.17-.5.44-.76.67-.18.16-.5.2-.75.07-.9-.44-1.64-.95-2.25-1.6-.46-.5-.85-1.06-1.22-1.65-.12-.2-.12-.45.01-.63.16-.23.35-.48.5-.65.14-.16.19-.32.28-.5.08-.18.04-.4-.07-.64-.11-.24-.76-1.82-1.07-2.49-.26-.59-.54-.51-.73-.52z"
        ></path>
      </svg>
    </a>
    <a
      href={fab.telegramUrl}
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#229ED9] text-white shadow-lg ring-2 ring-white/15 transition-transform hover:scale-105 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neon-cyan"
      aria-label={fab.telegramLabel}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        class="h-7 w-7"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="currentColor"
      >
        <path
          d="M11.944 0A11.944 11.944 0 0 0 0 11.944a11.944 11.944 0 0 0 11.944 11.944 11.944 11.944 0 0 0 11.944-11.944A11.944 11.944 0 0 0 11.944 0zm5.58 8.16c-.22 2.32-1.17 7.95-1.65 10.53-.2 1.09-.6 1.45-.98 1.49-.83.08-1.46-.55-2.27-1.08-1.26-.83-1.97-1.35-3.19-2.16-1.41-.93-.5-1.44.31-2.27.21-.22 3.9-3.57 3.97-3.87.01-.04.02-.19-.07-.27-.08-.08-.2-.05-.29-.03-.12.02-2.06 1.31-5.82 3.86-.55.38-1.05.57-1.5.56-.49-.01-1.44-.28-2.14-.52-.86-.28-1.54-.43-1.48-.91.03-.25.38-.51 1.05-.78 4.11-1.79 6.86-2.97 8.24-3.56 3.92-1.65 4.73-1.94 5.26-1.96.12 0 .38.03.55.17.14.12.18.28.2.45-.02.1-.02.21-.04.31z"
        ></path>
      </svg>
    </a>
  </div>

  <div class="relative">
    <span
      class="messenger-fab-pulse pointer-events-none absolute inset-0 rounded-full bg-neon-cyan/35"
      aria-hidden="true"></span>
    <button
      type="button"
      id="messenger-fab-toggle"
      class="relative flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-neon-cyan to-blue-600 text-ink shadow-[0_0_24px_rgba(34,211,238,0.45)] ring-2 ring-neon-cyan/40 transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      aria-expanded="false"
      aria-controls="messenger-fab-panel"
      aria-label={fab.toggleLabel}
      data-label-open={fab.toggleLabel}
      data-label-close={fab.toggleLabelClose}
    >
      <svg
        id="messenger-fab-icon-chat"
        class="h-7 w-7"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        ></path>
      </svg>
      <svg
        id="messenger-fab-icon-close"
        class="absolute h-7 w-7 hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .messenger-fab-pulse {
    animation: messenger-fab-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes messenger-fab-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById("messenger-fab-root");
    const panel = document.getElementById("messenger-fab-panel");
    const toggle = document.getElementById("messenger-fab-toggle");
    const iconChat = document.getElementById("messenger-fab-icon-chat");
    const iconClose = document.getElementById("messenger-fab-icon-close");

    if (!root || !panel || !toggle) return;

    const openLabel = toggle.getAttribute("data-label-open") || "";
    const closeLabel = toggle.getAttribute("data-label-close") || "";

    const setOpen = (open) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
      panel.hidden = !open;
      iconChat?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };

    let open = false;

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      open = !open;
      setOpen(open);
    });

    document.addEventListener("click", () => {
      if (!open) return;
      open = false;
      setOpen(false);
    });

    root.addEventListener("click", (e) => e.stopPropagation());

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) {
        open = false;
        setOpen(false);
      }
    });
  })();
</script>
