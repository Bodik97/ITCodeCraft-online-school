  {/* ---------- PAGE SCRIPTS ---------- */}
  <script>
    // Success / error feedback for the lead form
    document.addEventListener("itcc:form-success", () => {
      document.querySelector("[data-mc-form]")?.setAttribute("hidden", "");
      document.querySelector("[data-mc-error]")?.setAttribute("hidden", "");
      document.querySelector("[data-mc-success]")?.removeAttribute("hidden");
      document
        .getElementById("register")
        ?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
    document.addEventListener("itcc:form-error", () => {
      document.querySelector("[data-mc-error]")?.removeAttribute("hidden");
    });

    // Interactive timeline accordion
    const steps = Array.from(document.querySelectorAll<HTMLElement>(".mc-step"));
    steps.forEach((step, i) => {
      if (i === 0) step.classList.add("is-active");
      step.addEventListener("click", () => {
        const wasActive = step.classList.contains("is-active");
        steps.forEach((s) => s.classList.remove("is-active"));
        if (!wasActive) step.classList.add("is-active");
      });
    });

    // Animated counters
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const counters =
      document.querySelectorAll<HTMLElement>(".mc-counter[data-mc-count]");
    const runCounter = (el: HTMLElement) => {
      const raw = el.dataset.mcCount || "";
      const suffix = raw.replace(/[\d.]/g, "");
      const target = parseFloat(raw);
      if (isNaN(target)) return;
      const isFloat = raw.includes(".");
      const decimals = isFloat ? 1 : 0;
      const duration = 1500;
      const start = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const val = target * ease(p);
        el.textContent =
          (isFloat ? val.toFixed(decimals) : Math.floor(val).toString()) +
          suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (prefersReduced) {
      // leave static values as-is
    } else {
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              runCounter(e.target as HTMLElement);
              cio.unobserve(e.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      counters.forEach((el) => cio.observe(el));
    }

    // Skill bars fill on scroll
    const skillsWrap = document.getElementById("mc-skills");
    if (skillsWrap) {
      const bars =
        skillsWrap.querySelectorAll<HTMLElement>(".mc-bar-fill[data-mc-level]");
      const fill = () =>
        bars.forEach((b) => {
          b.style.width = `${b.dataset.mcLevel}%`;
        });
      if (prefersReduced) {
        fill();
      } else {
        const sio = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              fill();
              sio.disconnect();
            }
          },
          { threshold: 0.3 },
        );
        sio.observe(skillsWrap);
      }
    }

    // Interactive redstone schema — activate gray components in the right order
    const pg = document.getElementById("mc-playground");
    if (pg) {
      const buttons = Array.from(
        pg.querySelectorAll<HTMLButtonElement>(".mc-pg-btn"),
      );
      const chips = Array.from(pg.querySelectorAll<HTMLElement>("[data-schema]"));
      const conns = Array.from(pg.querySelectorAll<HTMLElement>("[data-conn]"));
      const resetBtn = pg.querySelector<HTMLElement>("[data-pg-reset]");
      const lamp = pg.querySelector<HTMLElement>("[data-pg-lamp]");
      const statusEl = pg.querySelector<HTMLElement>("[data-pg-status]");
      const idleText = statusEl?.textContent?.trim() || "";
      const order = chips.map((ch) => ch.dataset.schema || "");
      let expected = 0;

      const labelOf = (id: string) => {
        const b = buttons.find((x) => x.dataset.comp === id);
        return b ? (b.textContent || "").trim() : id;
      };

      const stage = pg.querySelector<HTMLElement>("[data-pg-stage]");
      const burstSparks = () => {
        if (prefersReduced || !stage) return;
        for (let i = 0; i < 12; i++) {
          const s = document.createElement("span");
          s.className = "mc-spark";
          const ang = (Math.PI * 2 * i) / 12 + Math.random() * 0.4;
          const dist = 40 + Math.random() * 45;
          s.style.left = "50%";
          s.style.top = "58%";
          s.style.setProperty("--tx", `${Math.cos(ang) * dist}px`);
          s.style.setProperty("--ty", `${Math.sin(ang) * dist}px`);
          stage.appendChild(s);
          setTimeout(() => s.remove(), 760);
        }
      };
      const shakeStage = () => {
        if (prefersReduced || !stage) return;
        stage.classList.add("mc-stage-shake");
        setTimeout(() => stage.classList.remove("mc-stage-shake"), 430);
      };

      const lightChip = (chip: HTMLElement) => {
        const color = chip.dataset.color || "#fc4a3a";
        chip.style.setProperty("--mc-glow", color);
        chip.style.background = "#1f2630";
        chip.classList.add("is-on", "just-on");
        setTimeout(() => chip.classList.remove("just-on"), 520);
      };

      const setStatus = (text: string, color: string) => {
        if (!statusEl) return;
        statusEl.textContent = text;
        statusEl.style.color = color;
      };

      const success = () => {
        if (lamp) {
          lamp.classList.add("is-on", "surge");
          setTimeout(() => lamp.classList.remove("surge"), 750);
        }
        burstSparks();
        shakeStage();
        setStatus("Механізм працює — лампа горить!", "#ffce6b");
        buttons.forEach((b) => b.setAttribute("disabled", ""));
      };

      const reset = () => {
        expected = 0;
        chips.forEach((ch) => {
          ch.classList.remove("is-on", "just-on");
          ch.style.removeProperty("--mc-glow");
          ch.style.background = "";
        });
        conns.forEach((cn) => cn.classList.remove("is-on"));
        if (lamp) {
          lamp.classList.remove("is-on", "surge");
        }
        buttons.forEach((b) => b.removeAttribute("disabled"));
        if (statusEl) {
          statusEl.textContent = idleText;
          statusEl.style.color = "";
        }
      };

      buttons.forEach((btn) =>
        btn.addEventListener("click", () => {
          if (expected >= order.length) return;
          const id = btn.dataset.comp || "";
          if (id === order[expected]) {
            const chip = chips[expected];
            lightChip(chip);
            if (expected > 0 && conns[expected - 1])
              conns[expected - 1].classList.add("is-on");
            btn.setAttribute("disabled", "");
            expected++;
            if (expected >= order.length) success();
            else setStatus(`Далі увімкни: ${labelOf(order[expected])}`, "#9fb0c7");
          } else {
            setStatus(`⚠ Спершу увімкни: ${labelOf(order[expected])}`, "#fca5a5");
          }
        }),
      );

      resetBtn?.addEventListener("click", reset);
    }

    // Interactive quiz
    const quizEl = document.getElementById("mc-quiz");
    if (quizEl) {
      const qSteps = Array.from(
        quizEl.querySelectorAll<HTMLElement>("[data-quiz-step]"),
      );
      const total = qSteps.length;
      const progressEl = quizEl.querySelector<HTMLElement>("[data-quiz-progress]");
      const fillEl = quizEl.querySelector<HTMLElement>("[data-quiz-fill]");
      const resultEl = quizEl.querySelector<HTMLElement>("[data-quiz-result]");
      const tagsEl = quizEl.querySelector<HTMLElement>("[data-quiz-tags]");
      const restartBtn = quizEl.querySelector<HTMLElement>("[data-quiz-restart]");
      const answers: string[] = [];

      const setProgress = (n: number) => {
        if (fillEl) fillEl.style.width = `${(n / total) * 100}%`;
      };
      const showStep = (i: number) => {
        qSteps.forEach((s, idx) => (s.hidden = idx !== i));
        if (resultEl) resultEl.hidden = true;
        if (progressEl) progressEl.textContent = `Крок ${i + 1}/${total}`;
        setProgress(i + 1);
      };
      const showResult = () => {
        qSteps.forEach((s) => (s.hidden = true));
        if (progressEl) progressEl.textContent = "Готово!";
        setProgress(total);
        if (tagsEl) {
          tagsEl.innerHTML = "";
          answers.forEach((tag) => {
            const li = document.createElement("li");
            li.className = "flex items-start gap-3 text-[#374151]";
            li.innerHTML =
              '<span class="inline-flex w-6 h-6 rounded-[4px] bg-[#5dae3f] items-center justify-center text-white text-sm shrink-0">✓</span><span class="leading-snug">' +
              tag +
              "</span>";
            tagsEl.appendChild(li);
          });
        }
        if (resultEl) resultEl.hidden = false;
      };

      qSteps.forEach((step, i) => {
        step.querySelectorAll<HTMLElement>(".quiz-option").forEach((btn) => {
          btn.addEventListener("click", () => {
            answers[i] = btn.getAttribute("data-tag") || "";
            if (i < total - 1) showStep(i + 1);
            else showResult();
          });
        });
      });

      restartBtn?.addEventListener("click", () => {
        answers.length = 0;
        showStep(0);
      });
    }
  </script>
