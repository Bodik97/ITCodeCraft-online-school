---
import MinecraftLayout from "@/layouts/MinecraftLayout.astro";
import MessengerFab from "@/components/shared/MessengerFab.astro";
import LeadModal from "@/components/shared/LeadModal.astro";
import MobileStickyCta from "@/components/shared/MobileStickyCta.astro";
import Footer from "@/sections/main/Footer.astro";
import content from "@/data/minecraft.json";
import Header from "@/sections/minecraft/Header.astro";
import Hero from "@/sections/minecraft/Hero.astro";
import Playground from "@/sections/minecraft/Playground.astro";
import Why from "@/sections/minecraft/Why.astro";
import Skills from "@/sections/minecraft/Skills.astro";
import Results from "@/sections/minecraft/Results.astro";
import Quiz from "@/sections/minecraft/Quiz.astro";
import How from "@/sections/minecraft/How.astro";
import Projects from "@/sections/minecraft/Projects.astro";
import Testimonials from "@/sections/minecraft/Testimonials.astro";
import Faq from "@/sections/minecraft/Faq.astro";
import Parents from "@/sections/minecraft/Parents.astro";
import Guarantee from "@/sections/minecraft/Guarantee.astro";
import Register from "@/sections/minecraft/Register.astro";

const { register, footer } = content;
---

<MinecraftLayout>
  <Header />
  <main id="main-content" class="flex-1">
    <Hero />
    <Playground />
    <Why />
    <Skills />
    <Results />
    <Quiz />
    <How />
    <Projects />
    <Testimonials />
    <Faq />
    <Parents />
    <Guarantee />
    <Register />
  </main>
  <Footer />
  <div class="lg:hidden h-20" aria-hidden="true"></div>
  <MobileStickyCta
    label="Записати на безоплатний урок"
    barClass="bg-[#3a7d20]/95 border-t-2 border-[#1f2937]"
    btnClass="mc-btn mc-btn-gold"
  />
  <MessengerFab
    accent="#5dae3f"
    accentRgb="93, 174, 63"
    accentDark="#3a7d20"
    fg="#ffffff"
    position="bottom-24 right-5 sm:right-6"
  />
  <LeadModal
    formId="minecraft-modal"
    title={register.title}
    accent="#5dae3f"
    accentRgb="93, 174, 63"
    accentFg="#ffffff"
    phone={footer.phone}
  />
  <script>
    import { initLandingInteractions } from "@/lib/landing";
    initLandingInteractions({
      prefix: "mc",
      quiz: {
        quizId: "mc-quiz",
        tagItemClass: "flex items-start gap-3 text-[#374151]",
        checkBadgeHtml: "<span class=\"inline-flex w-6 h-6 rounded-[4px] bg-[#5dae3f] items-center justify-center text-white text-sm shrink-0\">\u2713</span>",
      },
    });
  </script>
</MinecraftLayout>
