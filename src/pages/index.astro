---
import MainLayout from "@/layouts/MainLayout.astro";
import SignupNotification from "@/components/shared/SignupNotification.astro";
import MessengerFab from "@/components/shared/MessengerFab.astro";
import Modal from "@/components/main/modal/Modal.astro";
import ModalError from "@/components/main/modal/ModalError.astro";
import ModalSuccess from "@/components/main/modal/ModalSuccess.astro";
import content from "@/data/main.json";
import Header from "@/sections/main/Header.astro";
import Hero from "@/sections/main/Hero.astro";
import Why from "@/sections/main/Why.astro";
import Courses from "@/sections/main/Courses.astro";
import Works from "@/sections/main/Works.astro";
import Reviews from "@/sections/main/Reviews.astro";
import FAQ from "@/sections/main/FAQ.astro";
import RegisterForm from "@/sections/main/RegisterForm.astro";
import Footer from "@/sections/main/Footer.astro";

const initialNotificationAvatar =
  content.signupNotifications[0]?.name?.charAt(0) ?? "";

const runtimeData = {
  notifications: content.signupNotifications,
  onlineCount: content.navigation.initialOnlineCount,
  openMenuLabel: content.navigation.openMenuLabel,
  closeMenuLabel: content.navigation.closeMenuLabel,
  defaultAvatar: initialNotificationAvatar,
};
---

<MainLayout
  lang={content.meta.lang}
  title={content.meta.title}
  description={content.meta.description}
  canonicalUrl={content.meta.canonical}
  runtimeData={runtimeData}
>
  <Header />

  <main>
    <Hero />
    <Why />
    <Courses />
    <Works />
    <Reviews />
    <FAQ />
    <RegisterForm />
  </main>

  <Footer />
  <div class="lg:hidden h-20" aria-hidden="true"></div>
  <SignupNotification initialAvatar={initialNotificationAvatar} />
  <MessengerFab />

  <div
    class="lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-neon-cyan/30 bg-paper/95 backdrop-blur-md pb-[env(safe-area-inset-bottom)]"
  >
    <div class="px-4 py-2">
      <button
        type="button"
        data-modal-open
        class="w-full px-4 py-2.5 bg-neon-cyan text-paper font-bold text-sm rounded-lg shadow-neon-cyan flex items-center justify-center gap-2"
      >
        {content.hero.ctaPrimary}
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <Modal />
  <ModalError />
  <ModalSuccess />
</MainLayout>
