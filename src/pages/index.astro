---
import HomeLayout from "@/layouts/HomeLayout.astro";
import MessengerFab from "@/components/shared/MessengerFab.astro";
import Modal from "@/components/main/modal/Modal.astro";
import ModalError from "@/components/main/modal/ModalError.astro";
import ModalSuccess from "@/components/main/modal/ModalSuccess.astro";
import content from "@/data/main.json";
import Header from "@/sections/home/Header.astro";
import Hero from "@/sections/home/Hero.astro";
import Why from "@/sections/home/Why.astro";
import Showcase from "@/sections/home/Showcase.astro";
import Courses from "@/sections/home/Courses.astro";
import TrialSteps from "@/sections/home/TrialSteps.astro";
import Works from "@/sections/home/Works.astro";
import Reviews from "@/sections/home/Reviews.astro";
import FAQ from "@/sections/home/FAQ.astro";
import ParentPerks from "@/sections/home/ParentPerks.astro";
import RegisterForm from "@/sections/home/RegisterForm.astro";
import Footer from "@/sections/home/Footer.astro";

// Сповіщення «хтось щойно записався» прибрано: дані не реальні, це підриває довіру батьків
const runtimeData = {
  openMenuLabel: content.navigation.openMenuLabel,
  closeMenuLabel: content.navigation.closeMenuLabel,
};
---

<HomeLayout
  lang={content.meta.lang}
  title={content.meta.title}
  description={content.meta.description}
  canonicalUrl={content.meta.canonical}
  runtimeData={runtimeData}
>
  <Header />

  <main>
    <!-- Обіцянка → напрямки → докази → як проходить урок → чому ми → відгуки → гарантія → заперечення → дія -->
    <Hero />
    <Courses />
    <Works />
    <TrialSteps />
    <Why />
    <Showcase />
    <Reviews />
    <ParentPerks />
    <FAQ />
    <RegisterForm />
  </main>

  <Footer />
  <div class="h-20 lg:hidden" aria-hidden="true"></div>
  <MessengerFab accent="#7a6cf5" accentRgb="100, 87, 240" accentDark="#6457f0" fg="#ffffff" position="bottom-24 right-3 sm:right-6 lg:bottom-6" />

  <!-- Мобільна «липка» кнопка запису: з'являється, коли кнопка в hero вже прокручена -->
  <div data-sticky-cta class="h-fixed-reveal fixed inset-x-0 bottom-0 z-40 px-3 pb-[max(12px,env(safe-area-inset-bottom))] lg:hidden">
    <button type="button" data-modal-open class="h-btn h-btn-primary h-13 w-full shadow-[var(--h-shadow-lift)]">
      {content.hero.ctaPrimary}
      <span aria-hidden="true">→</span>
    </button>
  </div>
  <Modal />
  <ModalError />
  <ModalSuccess />
</HomeLayout>

<script is:inline>
  // На мобільних ховаємо липку CTA й кнопку месенджерів, поки видно головну кнопку hero:
  // не дублюємо дію на першому екрані й не перекриваємо контент
  (function () {
    var heroCta = document.querySelector("#hero [data-modal-open]");
    var targets = [document.querySelector("[data-sticky-cta]"), document.getElementById("messenger-fab-root")].filter(Boolean);
    if (!heroCta || !("IntersectionObserver" in window)) return;
    targets.forEach(function (el) {
      el.classList.add("h-fixed-reveal");
    });
    var mq = window.matchMedia("(max-width: 1023px)");
    var heroVisible = true;
    var sync = function () {
      var hide = mq.matches && heroVisible;
      targets.forEach(function (el) {
        el.classList.toggle("is-concealed", hide);
      });
    };
    new IntersectionObserver(function (entries) {
      heroVisible = entries[0].isIntersecting;
      sync();
    }).observe(heroCta);
    mq.addEventListener("change", sync);
    sync();
  })();
</script>
