---
import ScratchLayout from "@/layouts/ScratchLayout.astro";
import MessengerFab from "@/components/shared/MessengerFab.astro";
import LeadModal from "@/components/shared/LeadModal.astro";
import MobileStickyCta from "@/components/shared/MobileStickyCta.astro";
import Footer from "@/sections/main/Footer.astro";
import content from "@/data/scratch.json";
import Header from "@/sections/scratch/Header.astro";
import Hero from "@/sections/scratch/Hero.astro";
import Playground from "@/sections/scratch/Playground.astro";
import Why from "@/sections/scratch/Why.astro";
import Skills from "@/sections/scratch/Skills.astro";
import Results from "@/sections/scratch/Results.astro";
import Quiz from "@/sections/scratch/Quiz.astro";
import How from "@/sections/scratch/How.astro";
import Creations from "@/sections/scratch/Creations.astro";
import Testimonials from "@/sections/scratch/Testimonials.astro";
import Faq from "@/sections/scratch/Faq.astro";
import Parents from "@/sections/scratch/Parents.astro";
import Guarantee from "@/sections/scratch/Guarantee.astro";
import Register from "@/sections/scratch/Register.astro";

const { register, footer } = content;
---

<ScratchLayout>
  <Header />
  <main id="main-content" class="flex-1">
    <Hero />
    <Playground />
    <Why />
    <Skills />
    <Results />
    <Quiz />
    <How />
    <Creations />
    <Testimonials />
    <Faq />
    <Parents />
    <Guarantee />
    <Register />
  </main>
  <Footer />
  <div class="lg:hidden h-20" aria-hidden="true"></div>
  <MobileStickyCta
    label="Записати на безоплатний урок"
    barClass="bg-white/92 border-t border-[#f0e6d6]"
    btnClass="sc-btn sc-btn-primary"
  />
  <MessengerFab
    accent="#ff8c1a"
    accentRgb="255, 140, 26"
    accentDark="#d96b00"
    fg="#ffffff"
    position="bottom-24 right-5 sm:right-6"
  />
  <LeadModal
    formId="scratch-modal"
    title={register.title}
    accent="#ff8c1a"
    accentRgb="255, 140, 26"
    accentFg="#ffffff"
    phone={footer.phone}
  />
  <script>
    import { initLandingInteractions } from "@/lib/landing";
    initLandingInteractions({
      prefix: "sc",
      quiz: {
        quizId: "sc-quiz",
        tagItemClass: "flex items-start gap-3 text-[#4b4560]",
        checkBadgeHtml: "<span class=\"inline-flex w-6 h-6 rounded-lg bg-[#ff8c1a] items-center justify-center text-white text-sm shrink-0\">\u2713</span>",
      },
    });
  </script>
</ScratchLayout>
