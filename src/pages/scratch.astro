  {/* ---------- PAGE SCRIPTS ---------- */}
  <script>
    document.addEventListener("itcc:form-success", () => {
      document.querySelector("[data-sc-form]")?.setAttribute("hidden", "");
      document.querySelector("[data-sc-error]")?.setAttribute("hidden", "");
      document.querySelector("[data-sc-success]")?.removeAttribute("hidden");
      document
        .getElementById("register")
        ?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
    document.addEventListener("itcc:form-error", () => {
      document.querySelector("[data-sc-error]")?.removeAttribute("hidden");
    });

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Timeline accordion
    const steps = Array.from(document.querySelectorAll<HTMLElement>(".sc-step"));
    steps.forEach((step, i) => {
      if (i === 0) step.classList.add("is-active");
      step.addEventListener("click", () => {
        const wasActive = step.classList.contains("is-active");
        steps.forEach((s) => s.classList.remove("is-active"));
        if (!wasActive) step.classList.add("is-active");
      });
    });

    // Counters
    const counters =
      document.querySelectorAll<HTMLElement>(".sc-counter[data-sc-count]");
    const runCounter = (el: HTMLElement) => {
      const raw = el.dataset.scCount || "";
      const suffix = raw.replace(/[\d.]/g, "");
      const target = parseFloat(raw);
      if (isNaN(target)) return;
      const isFloat = raw.includes(".");
      const decimals = isFloat ? 1 : 0;
      const duration = 1500;
      const start = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const val = target * ease(p);
        el.textContent =
          (isFloat ? val.toFixed(decimals) : Math.floor(val).toString()) +
          suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (!prefersReduced) {
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              runCounter(e.target as HTMLElement);
              cio.unobserve(e.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      counters.forEach((el) => cio.observe(el));
    }

    // Skill bars
    const skillsWrap = document.getElementById("sc-skills");
    if (skillsWrap) {
      const bars =
        skillsWrap.querySelectorAll<HTMLElement>(".sc-bar-fill[data-sc-level]");
      const fill = () =>
        bars.forEach((b) => {
          b.style.width = `${b.dataset.scLevel}%`;
        });
      if (prefersReduced) {
        fill();
      } else {
        const sio = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              fill();
              sio.disconnect();
            }
          },
          { threshold: 0.3 },
        );
        sio.observe(skillsWrap);
      }
    }

    // Interactive playground "Збери програму"
    const pg = document.getElementById("sc-playground");
    if (pg) {
      const palette = pg.querySelectorAll<HTMLElement>(".sc-pg-block");
      const scriptList = pg.querySelector<HTMLElement>("[data-pg-script]");
      const emptyEl = pg.querySelector<HTMLElement>("[data-pg-empty]");
      const runBtn = pg.querySelector<HTMLButtonElement>("[data-pg-run]");
      const clearBtn = pg.querySelector<HTMLElement>("[data-pg-clear]");
      const sprite = pg.querySelector<HTMLElement>("[data-pg-sprite]");
      const bubble = pg.querySelector<HTMLElement>("[data-pg-bubble]");
      const program: { action: string; label: string }[] = [];
      let x = 0;
      let running = false;

      const render = () => {
        scriptList?.querySelectorAll("[data-pg-item]").forEach((n) => n.remove());
        if (program.length === 0) {
          emptyEl?.removeAttribute("hidden");
          return;
        }
        emptyEl?.setAttribute("hidden", "");
        program.forEach((p, idx) => {
          const li = document.createElement("li");
          li.setAttribute("data-pg-item", "");
          li.className =
            "flex items-center gap-2 rounded-xl bg-white border-2 border-[#f0e6d6] px-3 py-2 text-sm font-bold text-[#2b2440]";
          li.textContent = `${idx + 1}. ${p.label}`;
          scriptList?.appendChild(li);
        });
      };

      const resetSprite = () => {
        x = 0;
        if (sprite) sprite.style.transform = "";
        bubble?.setAttribute("hidden", "");
      };

      palette.forEach((btn) =>
        btn.addEventListener("click", () => {
          if (program.length >= 8) return;
          program.push({
            action: btn.dataset.action || "",
            label: btn.dataset.label || "",
          });
          render();
        }),
      );

      clearBtn?.addEventListener("click", () => {
        program.length = 0;
        render();
        resetSprite();
      });

      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const say = (msg: string) => {
        if (!bubble) return;
        bubble.textContent = msg;
        bubble.removeAttribute("hidden");
      };

      runBtn?.addEventListener("click", async () => {
        if (running || !sprite || program.length === 0) return;
        running = true;
        runBtn.setAttribute("disabled", "");
        resetSprite();
        await wait(200);
        for (const step of program) {
          if (step.action === "move") {
            x = Math.min(x + 60, 190);
            sprite.style.transform = `translateX(${x}px)`;
          } else if (step.action === "jump") {
            sprite.style.transform = `translateX(${x}px) translateY(-60px)`;
            await wait(300);
            sprite.style.transform = `translateX(${x}px) translateY(0)`;
          } else if (step.action === "spin") {
            sprite.style.transform = `translateX(${x}px) rotate(360deg)`;
            await wait(600);
            sprite.style.transform = `translateX(${x}px) rotate(0deg)`;
          } else if (step.action === "say") {
            say("Привіт!");
            await wait(700);
            bubble?.setAttribute("hidden", "");
          } else if (step.action === "sound") {
            say("Мяу!");
            sprite.style.transform = `translateX(${x}px) scale(1.18)`;
            await wait(280);
            sprite.style.transform = `translateX(${x}px) scale(1)`;
            await wait(250);
            bubble?.setAttribute("hidden", "");
          }
          await wait(420);
        }
        running = false;
        runBtn.removeAttribute("disabled");
      });
    }

    // Quiz
    const quizEl = document.getElementById("sc-quiz");
    if (quizEl) {
      const qSteps = Array.from(
        quizEl.querySelectorAll<HTMLElement>("[data-quiz-step]"),
      );
      const total = qSteps.length;
      const progressEl = quizEl.querySelector<HTMLElement>("[data-quiz-progress]");
      const fillEl = quizEl.querySelector<HTMLElement>("[data-quiz-fill]");
      const resultEl = quizEl.querySelector<HTMLElement>("[data-quiz-result]");
      const tagsEl = quizEl.querySelector<HTMLElement>("[data-quiz-tags]");
      const restartBtn = quizEl.querySelector<HTMLElement>("[data-quiz-restart]");
      const answers: string[] = [];

      const setProgress = (n: number) => {
        if (fillEl) fillEl.style.width = `${(n / total) * 100}%`;
      };
      const showStep = (i: number) => {
        qSteps.forEach((s, idx) => (s.hidden = idx !== i));
        if (resultEl) resultEl.hidden = true;
        if (progressEl) progressEl.textContent = `Крок ${i + 1}/${total}`;
        setProgress(i + 1);
      };
      const showResult = () => {
        qSteps.forEach((s) => (s.hidden = true));
        if (progressEl) progressEl.textContent = "Готово!";
        setProgress(total);
        if (tagsEl) {
          tagsEl.innerHTML = "";
          answers.forEach((tag) => {
            const li = document.createElement("li");
            li.className = "flex items-start gap-3 text-[#4b4560]";
            li.innerHTML =
              '<span class="inline-flex w-6 h-6 rounded-lg bg-[#ff8c1a] items-center justify-center text-white text-sm shrink-0">✓</span><span class="leading-snug">' +
              tag +
              "</span>";
            tagsEl.appendChild(li);
          });
        }
        if (resultEl) resultEl.hidden = false;
      };

      qSteps.forEach((step, i) => {
        step.querySelectorAll<HTMLElement>(".quiz-option").forEach((btn) => {
          btn.addEventListener("click", () => {
            answers[i] = btn.getAttribute("data-tag") || "";
            if (i < total - 1) showStep(i + 1);
            else showResult();
          });
        });
      });

      restartBtn?.addEventListener("click", () => {
        answers.length = 0;
        showStep(0);
      });
    }
  </script>
  <div class="lg:hidden h-20" aria-hidden="true"></div>
  <MobileStickyCta
    label="Записати на безоплатний урок"
    barClass="bg-white/92 border-t border-[#f0e6d6]"
    btnClass="sc-btn sc-btn-primary"
  />
  <MessengerFab
    accent="#ff8c1a"
    accentRgb="255, 140, 26"
