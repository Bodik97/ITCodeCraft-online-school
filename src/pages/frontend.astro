        <div
          class="fe-reveal rounded-2xl bg-surface p-6 md:p-8 shadow-2xl"
          style="--form-accent:#6366f1;--form-accent-rgb:99, 102, 241;--form-accent-fg:#ffffff;"
        >
          <div data-fe-form>
            <UseForm formId="frontend-landing" />
