---
import FrontendLayout from "@/layouts/FrontendLayout.astro";
import MessengerFab from "@/components/shared/MessengerFab.astro";
import LeadModal from "@/components/shared/LeadModal.astro";
import MobileStickyCta from "@/components/shared/MobileStickyCta.astro";
import Footer from "@/sections/main/Footer.astro";
import content from "@/data/frontend.json";
import Header from "@/sections/frontend/Header.astro";
import Hero from "@/sections/frontend/Hero.astro";
import Why from "@/sections/frontend/Why.astro";
import Skills from "@/sections/frontend/Skills.astro";
import Quiz from "@/sections/frontend/Quiz.astro";
import How from "@/sections/frontend/How.astro";
import Projects from "@/sections/frontend/Projects.astro";
import Testimonials from "@/sections/frontend/Testimonials.astro";
import Faq from "@/sections/frontend/Faq.astro";
import Parents from "@/sections/frontend/Parents.astro";
import Register from "@/sections/frontend/Register.astro";

const { register, footer } = content;
---

<FrontendLayout>
  <Header />
  <main id="main-content" class="flex-1">
    <Hero />
    <Why />
    <Skills />
    <Quiz />
    <How />
    <Projects />
    <Testimonials />
    <Faq />
    <Parents />
    <Register />
  </main>
  <Footer />
  <div class="lg:hidden h-20" aria-hidden="true"></div>
  <MobileStickyCta
    label="Записати на безоплатний урок"
    barClass="bg-white/92 border-t border-slate-200"
    btnClass="fe-btn fe-btn-primary"
  />
  <MessengerFab
    accent="#6366f1"
    accentRgb="99, 102, 241"
    accentDark="#4f46e5"
    fg="#ffffff"
    position="bottom-24 right-5 sm:right-6"
  />
  <LeadModal
    formId="frontend-modal"
    title={register.title}
    accent="#6366f1"
    accentRgb="99, 102, 241"
    accentFg="#ffffff"
    phone={footer.phone}
  />
  <script>
    import { initLandingInteractions } from "@/lib/landing";
    initLandingInteractions({
      prefix: "fe",
      quiz: {
        quizId: "fe-quiz",
        tagItemClass: "flex items-start gap-3 text-slate-700",
        checkBadgeHtml: "<span class=\"inline-flex w-6 h-6 rounded-md bg-[#6366f1] items-center justify-center text-white text-sm shrink-0\">\u2713</span>",
      },
    });
  </script>
</FrontendLayout>
