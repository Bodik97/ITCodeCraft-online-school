  <Footer />

  {/* ---------- PAGE SCRIPTS ---------- */}
  <script>
    // Success / error feedback for the lead form
    document.addEventListener("itcc:form-success", () => {
      document.querySelector("[data-fe-form]")?.setAttribute("hidden", "");
      document.querySelector("[data-fe-error]")?.setAttribute("hidden", "");
      document.querySelector("[data-fe-success]")?.removeAttribute("hidden");
      document
        .getElementById("register")
        ?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
    document.addEventListener("itcc:form-error", () => {
      document.querySelector("[data-fe-error]")?.removeAttribute("hidden");
    });

    // Interactive timeline accordion
    const steps = Array.from(document.querySelectorAll<HTMLElement>(".fe-step"));
    steps.forEach((step, i) => {
      if (i === 0) step.classList.add("is-active");
      step.addEventListener("click", () => {
        const wasActive = step.classList.contains("is-active");
        steps.forEach((s) => s.classList.remove("is-active"));
        if (!wasActive) step.classList.add("is-active");
      });
    });

    // Animated counters
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const counters =
      document.querySelectorAll<HTMLElement>(".fe-counter[data-fe-count]");
    const runCounter = (el: HTMLElement) => {
      const raw = el.dataset.feCount || "";
      const suffix = raw.replace(/[\d.]/g, "");
      const target = parseFloat(raw);
      if (isNaN(target)) return;
      const isFloat = raw.includes(".");
      const decimals = isFloat ? 1 : 0;
      const duration = 1500;
      const start = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const val = target * ease(p);
        el.textContent =
          (isFloat ? val.toFixed(decimals) : Math.floor(val).toString()) +
          suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (!prefersReduced) {
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              runCounter(e.target as HTMLElement);
              cio.unobserve(e.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      counters.forEach((el) => cio.observe(el));
    }

    // Skill bars fill on scroll
    const skillsWrap = document.getElementById("fe-skills");
    if (skillsWrap) {
      const bars =
        skillsWrap.querySelectorAll<HTMLElement>(".fe-bar-fill[data-fe-level]");
      const fill = () =>
        bars.forEach((b) => {
          b.style.width = `${b.dataset.feLevel}%`;
        });
      if (prefersReduced) {
        fill();
      } else {
        const sio = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              fill();
              sio.disconnect();
            }
          },
          { threshold: 0.3 },
        );
        sio.observe(skillsWrap);
      }
    }

    // Typing console effect
    const typeEl = document.querySelector<HTMLElement>("[data-fe-type]");
    if (typeEl) {
      let lines: string[] = [];
      try {
        lines = JSON.parse(typeEl.dataset.feLines || "[]");
      } catch {
        lines = [];
      }
      if (lines.length && !prefersReduced) {
        const full = lines.join("\n");
        let i = 0;
        const type = () => {
          typeEl.textContent = full.slice(0, i);
          i += 1;
          if (i <= full.length) {
            setTimeout(type, full[i - 1] === "\n" ? 220 : 55);
          } else {
            setTimeout(() => {
              i = 0;
              type();
            }, 2600);
          }
        };
        type();
      } else {
        typeEl.textContent = lines.join("\n");
      }
    }

    // Interactive quiz
    const quizEl = document.getElementById("fe-quiz");
    if (quizEl) {
      const qSteps = Array.from(
        quizEl.querySelectorAll<HTMLElement>("[data-quiz-step]"),
      );
      const total = qSteps.length;
      const progressEl = quizEl.querySelector<HTMLElement>(
        "[data-quiz-progress]",
      );
      const fillEl = quizEl.querySelector<HTMLElement>("[data-quiz-fill]");
      const resultEl = quizEl.querySelector<HTMLElement>("[data-quiz-result]");
      const tagsEl = quizEl.querySelector<HTMLElement>("[data-quiz-tags]");
      const restartBtn = quizEl.querySelector<HTMLElement>("[data-quiz-restart]");
      const answers: string[] = [];

      const setProgress = (n: number) => {
        if (fillEl) fillEl.style.width = `${(n / total) * 100}%`;
      };
      const showStep = (i: number) => {
        qSteps.forEach((s, idx) => (s.hidden = idx !== i));
        if (resultEl) resultEl.hidden = true;
        if (progressEl) progressEl.textContent = `Крок ${i + 1}/${total}`;
        setProgress(i + 1);
      };
      const showResult = () => {
        qSteps.forEach((s) => (s.hidden = true));
        if (progressEl) progressEl.textContent = "Готово!";
        setProgress(total);
        if (tagsEl) {
          tagsEl.innerHTML = "";
          answers.forEach((tag) => {
            const li = document.createElement("li");
            li.className = "flex items-start gap-3 text-slate-700";
            li.innerHTML =
              '<span class="inline-flex w-6 h-6 rounded-md bg-[#6366f1] items-center justify-center text-white text-sm shrink-0">✓</span><span class="leading-snug">' +
              tag +
              "</span>";
            tagsEl.appendChild(li);
          });
        }
        if (resultEl) resultEl.hidden = false;
      };

      qSteps.forEach((step, i) => {
        step.querySelectorAll<HTMLElement>(".quiz-option").forEach((btn) => {
          btn.addEventListener("click", () => {
            answers[i] = btn.getAttribute("data-tag") || "";
            if (i < total - 1) showStep(i + 1);
            else showResult();
          });
        });
      });

      restartBtn?.addEventListener("click", () => {
        answers.length = 0;
        showStep(0);
      });
    }
  </script>
  <div class="lg:hidden h-20" aria-hidden="true"></div>
  <MobileStickyCta
