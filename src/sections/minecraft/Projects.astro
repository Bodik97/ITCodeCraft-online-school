---
import content from "@/data/minecraft.json";

interface ProjectCard {
  youtubeId: string;
  title: string;
  student: string;
  time: string;
}

interface Props {
  projects?: {
    eyebrow: string;
    title: string;
    subtitle: string;
    cards: ProjectCard[];
  };
}

const projects = Astro.props.projects ?? content.projects;
---

<section
  id="projects"
  class="py-16 md:py-24 bg-[#3a7d20] border-y-2 border-[#1f2937]"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12 mc-reveal">
      <span
        class="inline-block bg-white/15 text-white text-xs font-black px-3 py-1.5 rounded-full uppercase tracking-[0.15em] mb-4 border-2 border-white/25"
        >{projects.eyebrow}</span
      >
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-3">
        {projects.title}
      </h2>
      <p class="text-white/80 text-lg">{projects.subtitle}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      {
        projects.cards.map((card) => (
          <div class="mc-reveal mc-lift rounded-[10px] bg-white overflow-hidden mc-block">
            <div class="aspect-video bg-black">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube-nocookie.com/embed/${card.youtubeId}`}
                title={card.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            <div class="p-5">
              <h3 class="font-display text-xl font-bold">{card.title}</h3>
              <p class="text-sm text-[#6b7280] mt-1">
                {card.student} · {card.time}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
