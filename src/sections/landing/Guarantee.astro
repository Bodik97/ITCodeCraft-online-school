---
import { Icon } from "astro-icon/components";
import { getLandingTheme, type LandingPrefix } from "./theme";

interface Props {
  prefix: LandingPrefix;
  guarantee: {
    badge: string;
    title: string;
    text: string;
  };
}

const { prefix, guarantee } = Astro.props;
const t = getLandingTheme(prefix);
---

<section class={t.guaranteeSection}>
  <div
    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left"
  >
    <div class={t.guaranteeIconWrap}>
      <Icon name="lucide:shield-check" class="size-9" />
    </div>
    <div class={`${prefix}-reveal`}>
      <span class={t.guaranteeBadge}>{guarantee.badge}</span>
      <h3 class="font-display text-2xl font-bold text-white mb-1">
        {guarantee.title}
      </h3>
      <p class="text-white/70 text-sm md:text-base leading-relaxed">
        {guarantee.text}
      </p>
    </div>
  </div>
</section>
