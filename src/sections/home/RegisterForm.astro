---
import content from "@/data/main.json";
import UseForm from "@/components/main/form/UseForm.astro";

const section = content.registerSection;
---

<section id="register" class="h-wrap scroll-mt-28 pt-20 pb-6 md:pt-28" aria-labelledby="register-title">
  <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="h-pearl relative flex flex-col gap-6 overflow-hidden rounded-[var(--h-radius)] p-7 shadow-[var(--h-shadow-soft)] sm:p-10">
      <p class="h-eyebrow relative"><span>45 хв</span>{section.socialProof.trim()}</p>
      <h2 id="register-title" class="h-title relative">
        {section.titlePrefix} <span class="h-mark">{section.titleHighlight}</span>
      </h2>
      <p class="relative text-lg leading-relaxed text-[var(--h-soft)]">{section.description}</p>
      <ul class="relative flex flex-col gap-2">
        {
          section.features.map((feature, i) => (
            <li class="h-glass flex items-center gap-3 self-start rounded-full py-1.5 pr-5 pl-1.5 font-bold">
              <span
                class:list={[
                  "flex size-8 items-center justify-center rounded-full text-sm",
                  i === 0 ? "h-solid" : "bg-[var(--h-surface-2)]",
                ]}
                aria-hidden="true"
              >
                ✔
              </span>
              {feature}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="h-light relative flex flex-col justify-center gap-6 rounded-[var(--h-radius)] p-6 shadow-[0_30px_70px_-30px_rgb(4_0_30/0.9)] sm:p-10">
      <div class="flex flex-col gap-2">
        <h3 class="text-2xl font-extrabold">{section.forms.title}</h3>
        <p class="text-[15px] text-[var(--h-muted)]">{section.forms.inputsFields.ctaSecondary}</p>
      </div>
      <UseForm formId="register-section" />
    </div>
  </div>
</section>
