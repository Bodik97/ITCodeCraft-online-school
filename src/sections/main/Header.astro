---
import content from "@/data/main.json";
import Logo from "@/components/shared/Logo.astro";
---

<header
  id="site-header"
  class="header-shell py-6 fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <Logo href="https://itcodecraft.tech/" />

      <nav class="hidden lg:flex items-center gap-7 ml-6">
        {
          content.footerSection.navigationLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-slate-400 hover:text-neon-cyan transition-colors duration-200"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3 ml-2">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-sm border border-slate-200/30 text-slate-300 hover:text-neon-cyan hover:border-neon-cyan/45 transition-colors duration-200"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={content.navigation.openMenuLabel}
        >
          <svg
            id="menu-icon-open"
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="size-5 hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
        <button
          id="modal-open"
          type="button"
          class="hidden lg:inline-flex px-6 py-2 bg-neon-magenta text-white font-bold rounded-sm shadow-neon-magenta hover:scale-105 transition-transform duration-200 text-sm animate-neon-pulse"
        >
          {content.navigation.ctaLabel}
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="mobile-menu lg:hidden mt-4 rounded-sm border border-slate-200/30 bg-surface/95 backdrop-blur-sm p-4"
    >
      <nav class="flex flex-col gap-3">
        {
          content.footerSection.navigationLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-slate-300 hover:text-neon-cyan transition-colors duration-200"
            >
              {link.name}
            </a>
          ))
        }
      </nav>
      <button
        id="modal-open-mobile"
        type="button"
        data-modal-open
        class="mt-4 w-full px-5 py-2 bg-neon-magenta text-white font-bold rounded-sm shadow-neon-magenta text-sm"
      >
        {content.navigation.ctaLabel}
      </button>
    </div>
  </div>
</header>
