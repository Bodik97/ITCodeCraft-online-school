---
import content from "@/data/main.json";
import Logo from "@/components/shared/Logo.astro";

// Mobile menu adds the landing-page courses (grouped right after "Всі курси");
// the desktop nav stays compact without the course pages.
type NavLink = { name: string; href: string; isCourse?: boolean };
const courseLinks: NavLink[] = (content.navigation.mobileCourseLinks ?? []).map(
  (link) => ({ ...link, isCourse: true }),
);
const mobileLinks: NavLink[] = content.footerSection.navigationLinks.flatMap(
  (link) => (link.href === "#courses" ? [link, ...courseLinks] : [link]),
);
---

<header
  id="site-header"
  class="header-shell  fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <Logo href="https://itcodecraft.tech/" />

      <nav class="hidden lg:flex items-center gap-7 ml-6">
        {
          content.footerSection.navigationLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-slate-400 hover:text-neon-cyan transition-colors duration-200"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3 ml-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Перемкнути світлу / темну тему"
          class="inline-flex h-10 w-10 items-center justify-center rounded-sm border border-slate-200/30 text-slate-300 hover:text-neon-cyan hover:border-neon-cyan/45 transition-colors"
        >
          <svg
            class="theme-icon-moon size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg
            class="theme-icon-sun size-5 hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
          </svg>
        </button>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-sm border border-slate-200/30 text-slate-300 hover:text-neon-cyan hover:border-neon-cyan/45 transition-colors duration-200"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={content.navigation.openMenuLabel}
        >
          <svg
            id="menu-icon-open"
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="size-5 hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
        <button
          id="modal-open"
          type="button"
          class="hidden lg:inline-flex px-6 py-2 bg-neon-magenta text-white font-bold rounded-sm shadow-neon-magenta hover:scale-105 transition-transform duration-200 text-sm animate-neon-pulse"
        >
          {content.navigation.ctaLabel}
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="mobile-menu lg:hidden mt-4 rounded-sm border border-slate-200/30 bg-surface/95 backdrop-blur-sm p-4"
    >
      <nav class="flex flex-col gap-3">
        {
          mobileLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-sm font-medium transition-colors duration-200",
                link.isCourse
                  ? "text-neon-cyan underline decoration-neon-cyan/50 decoration-2 underline-offset-4 hover:decoration-neon-cyan"
                  : "text-slate-300 hover:text-neon-cyan",
              ]}
            >
              {link.name}
            </a>
          ))
        }
      </nav>
      <button
        id="modal-open-mobile"
        type="button"
        data-modal-open
        class="mt-4 w-full px-5 py-2 bg-neon-magenta text-white font-bold rounded-sm shadow-neon-magenta text-sm"
      >
        {content.navigation.ctaLabel}
      </button>
    </div>
  </div>
</header>
