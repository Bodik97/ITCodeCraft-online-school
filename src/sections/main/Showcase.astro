---
import content from "@/data/main.json";

const section = content.showcaseSection;
const accent = ["text-neon-cyan", "text-neon-magenta", "text-neon-lime"] as const;
const underlineBg = ["bg-neon-cyan", "bg-neon-magenta", "bg-neon-lime"] as const;
const glow = [
  "rgba(34,211,238,0.5)",
  "rgba(244,63,94,0.5)",
  "rgba(132,204,22,0.5)",
] as const;
const borderC = ["#22d3ee", "#f43f5e", "#84cc16"] as const;

// Travelling neon orbs (autonomous)
const orbs = [
  { top: "12%", color: "#22d3ee", dur: "9s", delay: "0s", size: 7 },
  { top: "34%", color: "#f43f5e", dur: "13s", delay: "2s", size: 5 },
  { top: "58%", color: "#84cc16", dur: "11s", delay: "1s", size: 6 },
  { top: "76%", color: "#22d3ee", dur: "15s", delay: "4s", size: 5 },
  { top: "90%", color: "#f43f5e", dur: "10s", delay: "3s", size: 6 },
];
// Drifting tick marks (autonomous)
const ticks = [
  { left: "12%", top: "20%", color: "#22d3ee", dur: "7s", delay: "0s", rot: 20 },
  { left: "44%", top: "14%", color: "#84cc16", dur: "9s", delay: "1.5s", rot: -15 },
  { left: "70%", top: "24%", color: "#f43f5e", dur: "8s", delay: "0.6s", rot: 35 },
  { left: "28%", top: "82%", color: "#84cc16", dur: "10s", delay: "2.2s", rot: -25 },
  { left: "84%", top: "78%", color: "#22d3ee", dur: "8.5s", delay: "1.2s", rot: 12 },
];
---

<section id="showcase" class="py-24 bg-transparent relative overflow-hidden">
  <div
    class="absolute top-0 left-0 w-full h-px bg-linear-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  {/* ---- Autonomous decorative moving layer ---- */}
  <div class="sc-deco-layer absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
    {
      orbs.map((o) => (
        <span
          class="sc-orb"
          style={`top:${o.top};color:${o.color};width:${o.size}px;height:${o.size}px;animation-duration:${o.dur};animation-delay:${o.delay}`}
        />
      ))
    }
    {
      ticks.map((t) => (
        <span
          class="sc-tick"
          style={`left:${t.left};top:${t.top};color:${t.color};--rot:${t.rot}deg;animation-duration:${t.dur};animation-delay:${t.delay}`}
        />
      ))
    }
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="mb-16 max-w-2xl">
      <h2 class="text-xl md:text-2xl font-bold font-display text-ink mb-4 xl:text-4xl">
        {section.titlePrefix}
        <span class="sc-pulse text-neon-cyan text-glow-cyan">
          {section.titleHighlight}
        </span>
      </h2>
      <p class="text-slate-500 text-sm md:text-base xl:text-lg">
        {section.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {
        section.cards.map((card, i) => (
          <div class="sc-floatwrap" style={`animation-delay:${i * 0.9}s`}>
            <article
              data-sc-tilt
              class="sc-card group relative h-full rounded-sm overflow-hidden border border-slate-200 bg-surface"
              style={`--glow:${glow[i % glow.length]};--bc:${borderC[i % borderC.length]}`}
            >
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={`./assets/home/${card.image}.webp`}
                  alt={card.title}
                  width="720"
                  height="540"
                  loading="lazy"
                  decoding="async"
                  class="sc-img w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-linear-to-t from-surface via-surface/30 to-transparent" />
                <div class="sc-sheen absolute inset-0" />
              </div>
              <div class="relative -mt-12 p-6">
                <h3
                  class:list={[
                    "text-xl font-bold font-display mb-2",
                    accent[i % accent.length],
                  ]}
                >
                  {card.title}
                </h3>
                <span
                  class:list={[
                    "sc-underline block h-[3px] w-10 mb-3 rounded-full",
                    underlineBg[i % underlineBg.length],
                  ]}
                />
                <p class="text-slate-500 text-sm leading-relaxed">{card.text}</p>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center sc-reveal">
      <a
        href="#courses"
        class="inline-flex items-center gap-2 px-7 py-4 bg-neon-cyan text-[#062a31] font-bold rounded-xl shadow-neon-cyan hover:scale-[1.04] transition-transform duration-200 animate-neon-pulse"
      >
        Обрати напрямок для дитини
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ---- Travelling orbs ---- */
  .sc-orb {
    position: absolute;
    left: -2%;
    border-radius: 9999px;
    background: currentColor;
    box-shadow: 0 0 12px currentColor;
    opacity: 0;
    animation-name: sc-travel;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes sc-travel {
    0% {
      left: -2%;
      opacity: 0;
    }
    8% {
      opacity: 0.9;
    }
    92% {
      opacity: 0.6;
    }
    100% {
      left: 102%;
      opacity: 0;
    }
  }

  /* ---- Drifting tick marks ---- */
  .sc-tick {
    position: absolute;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    opacity: 0.35;
    box-shadow: 0 0 8px currentColor;
    transform: rotate(var(--rot, 0deg));
    animation-name: sc-drift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes sc-drift {
    0%,
    100% {
      transform: translate(0, 0) rotate(var(--rot, 0deg));
      opacity: 0.3;
    }
    50% {
      transform: translate(14px, -18px) rotate(calc(var(--rot, 0deg) + 12deg));
      opacity: 0.55;
    }
  }

  /* ---- Heading accent pulse ---- */
  .sc-pulse {
    animation: sc-textpulse 3s ease-in-out infinite;
  }
  @keyframes sc-textpulse {
    0%,
    100% {
      text-shadow: 0 0 14px rgba(34, 211, 238, 0.35);
    }
    50% {
      text-shadow:
        0 0 22px rgba(34, 211, 238, 0.7),
        0 0 4px rgba(34, 211, 238, 0.5);
    }
  }

  /* ---- Autonomous card float ---- */
  .sc-floatwrap {
    height: 100%;
    animation: sc-bob 6.5s ease-in-out infinite;
  }
  .sc-floatwrap:nth-child(2) {
    animation-duration: 7.4s;
  }
  .sc-floatwrap:nth-child(3) {
    animation-duration: 8.1s;
  }
  .sc-floatwrap:hover {
    animation-play-state: paused;
  }
  @keyframes sc-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* ---- Card reveal + hover ---- */
  .sc-card,
  .sc-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .sc-card.is-in,
  .sc-reveal.is-in {
    opacity: 1;
    transform: translateY(0);
  }
  .sc-card:hover {
    box-shadow: 0 26px 60px -18px var(--glow);
    border-color: var(--bc);
  }
  .sc-card.is-hover {
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.12s ease;
  }
  .sc-img {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sc-card:hover .sc-img {
    transform: scale(1.07);
  }
  .sc-underline {
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sc-card:hover .sc-underline {
    width: 3.75rem;
  }

  /* ---- Shimmer sweep across image (autonomous, staggered) ---- */
  .sc-sheen {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.14) 50%,
      transparent 60%
    );
    background-size: 220% 100%;
    background-position: 180% 0;
    animation: sc-sheen 6s ease-in-out infinite;
  }
  .sc-floatwrap:nth-child(2) .sc-sheen {
    animation-delay: 2s;
  }
  .sc-floatwrap:nth-child(3) .sc-sheen {
    animation-delay: 4s;
  }
  @keyframes sc-sheen {
    0%,
    65%,
    100% {
      background-position: 180% 0;
    }
    80% {
      background-position: -60% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-card,
    .sc-reveal {
      opacity: 1;
      transform: none;
      transition: box-shadow 0.3s ease;
    }
    .sc-card.is-hover,
    .sc-img,
    .sc-underline {
      transform: none;
      transition: none;
    }
    .sc-deco-layer,
    .sc-floatwrap,
    .sc-pulse,
    .sc-sheen {
      animation: none !important;
    }
    .sc-deco-layer {
      display: none;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const section = document.getElementById("showcase");
  if (section) {
    const revealEls = Array.from(
      section.querySelectorAll<HTMLElement>(".sc-card, .sc-reveal"),
    );
    if (prefersReduced) {
      revealEls.forEach((el) => el.classList.add("is-in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const el = e.target as HTMLElement;
              const idx = revealEls.indexOf(el);
              setTimeout(
                () => el.classList.add("is-in"),
                Math.max(0, idx) * 130,
              );
              io.unobserve(el);
            }
          });
        },
        { threshold: 0.15 },
      );
      revealEls.forEach((el) => io.observe(el));

      // 3D tilt on hover (bonus)
      section.querySelectorAll<HTMLElement>("[data-sc-tilt]").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          card.style.setProperty("--ry", `${px * 8}deg`);
          card.style.setProperty("--rx", `${-py * 8}deg`);
          card.classList.add("is-hover");
        });
        card.addEventListener("pointerleave", () => {
          card.classList.remove("is-hover");
          card.style.removeProperty("--rx");
          card.style.removeProperty("--ry");
        });
      });
    }
  }
</script>
