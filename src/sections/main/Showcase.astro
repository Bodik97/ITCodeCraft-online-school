---
import content from "@/data/main.json";

const section = content.showcaseSection;
const accent = ["text-neon-cyan", "text-neon-magenta", "text-neon-lime"] as const;
const ring = [
  "hover:border-neon-cyan/50",
  "hover:border-neon-magenta/50",
  "hover:border-neon-lime/50",
] as const;
---

<section id="showcase" class="py-24 bg-paper relative overflow-hidden">
  <div
    class="absolute top-0 left-0 w-full h-px bg-linear-to-r from-transparent via-white/10 to-transparent"
  >
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="mb-16 max-w-2xl">
      <h2 class="text-xl md:text-2xl font-bold font-display text-ink mb-4 xl:text-4xl">
        {section.titlePrefix}
        <span class="text-neon-cyan text-glow-cyan">{section.titleHighlight}</span>
      </h2>
      <p class="text-slate-500 text-sm md:text-base xl:text-lg">
        {section.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {
        section.cards.map((card, i) => (
          <article
            class:list={[
              "group relative rounded-sm overflow-hidden border border-slate-200 bg-surface transition-colors duration-300",
              ring[i % ring.length],
            ]}
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={`./assets/home/${card.image}.webp`}
                alt={card.title}
                width="720"
                height="540"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-surface via-surface/30 to-transparent" />
            </div>
            <div class="relative -mt-12 p-6">
              <h3
                class:list={[
                  "text-xl font-bold font-display mb-2",
                  accent[i % accent.length],
                ]}
              >
                {card.title}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed">{card.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
