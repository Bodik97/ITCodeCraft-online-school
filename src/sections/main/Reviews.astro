---
import content from "@/data/main.json";
import ReviewsCarousel from "@/components/main/ReviewsCarousel";

const brandPrimary = content.brand.primary ?? "ITCode";
const brandAccent = content.brand.accent ?? "Craft";
const brandPrefix = brandPrimary.startsWith("IT")
  ? "IT"
  : brandPrimary.slice(0, 2);
const brandBase = brandPrimary.slice(brandPrefix.length);
---

<section
  id="reviews"
  class="py-24 bg-transparent border-t border-slate-200/70 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class=" mb-16">
      <h2 class="text-xl  md:text-2xl font-bold font-display text-ink mb-4 xl:text-4xl">
        {content.reviewsSection.titlePrefix}
        <span class=""
          >
          <span class="ic-name">
            <span class="ic-name-prefix ">{brandPrefix}</span
            ><span class="ic-name-base ">{brandBase}</span><span
              class="ic-name-accent">{brandAccent}</span
            >
          </span>
        </span>
      </h2>
    </div>

    <ReviewsCarousel client:visible items={content.reviewsSection.reviews} />
  </div>
</section>

<style is:global>
  @keyframes reviewsSoftFade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .reviews-soft-fade {
    animation: reviewsSoftFade 0.4s ease-out forwards;
  }
</style>

<style>
  .ic-logo {
    --ic-cyan: var(--color-neon-cyan, #22d3ee);
    /* Pinned to the dark-theme colour so the school name never recolours. */
    --ic-text: #e6eef9;
    --ic-name-size: 26px;
  }

  .ic-name {
    font-family: "Outfit", "Inter", sans-serif;
    font-size: var(--ic-name-size);
    font-weight: 900;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* Light theme: keep the wordmark's fixed colours readable on a light heading
     by placing it on a small dark plate (same idea as the logo). */
  html.light .ic-name {
    background: #0e1629;
    padding: 0.06em 0.42em;
    border-radius: 0.4em;
  }

  .ic-name-prefix {
    color: var(--ic-cyan);
    text-shadow: 0 0 18px rgba(34, 211, 238, 0.45);
    color: #22d3ee;
  }

  .ic-name-base {
    color: #ffffff;
  }

  .ic-name-accent {
    color: rgba(255, 255, 255, 0.35);
    font-weight: 300;
    letter-spacing: -0.03em;
  }
</style>
