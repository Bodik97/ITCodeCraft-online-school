---
import content from "@/data/main.json";
import Arrow from "@/icons/arrow.svg";

const reviewBorders = [
  "border-l-neon-cyan",
  "border-l-neon-magenta",
  "border-l-neon-orange",
] as const;

const highlightReviewText = (text: string, highlight: string): string =>
  text.replace(
    highlight,
    `<span class="text-neon-cyan font-bold not-italic">${highlight}</span>`,
  );

const brandPrimary = content.brand.primary ?? "ITCode";
const brandAccent = content.brand.accent ?? "Craft";
const brandPrefix = brandPrimary.startsWith("IT")
  ? "IT"
  : brandPrimary.slice(0, 2);
const brandBase = brandPrimary.slice(brandPrefix.length);
---

<section
  id="reviews"
  class="py-24 bg-transparent border-t border-slate-200/70 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class=" mb-16">
      <h2 class="text-xl  md:text-2xl font-bold font-display text-ink mb-4 xl:text-4xl">
        {content.reviewsSection.titlePrefix}
        <span class=""
          >
          <span class="ic-name">
            <span class="ic-name-prefix ">{brandPrefix}</span
            ><span class="ic-name-base ">{brandBase}</span><span
              class="ic-name-accent">{brandAccent}</span
            >
          </span>
        </span>
      </h2>
    </div>

    <div class="relative">
      <div
        data-scroller
        class="reviews-scroll flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory pb-3 -mx-4 px-4 sm:mx-0 sm:px-0"
      >
        {
          content.reviewsSection.reviews.map((review, index) => (
            <article
              class:list={[
                "snap-start shrink-0 basis-[90%] md:basis-[48%] xl:basis-[34%] bg-surface min-h-[300px] p-8 rounded-sm border-l-4 group hover:bg-surface-light transition-colors duration-300 flex flex-col",
                reviewBorders[index % reviewBorders.length],
              ]}
            >
              <div
                class="text-ink/15 font-display text-5xl leading-none mb-3"
                aria-hidden="true"
              >
                "
              </div>

              <p
                class="text-slate-600 leading-relaxed mb-6 flex-1"
                set:html={`${highlightReviewText(review.text, review.highlight)}`}
              />

              <div class="flex items-center gap-3 border-t border-slate-200/70 pt-4 mt-auto">
                <img
                  src={`./assets/reviews/${review.img}.webp`}
                  alt={review.name}
                  width="44"
                  height="44"
                  class="w-11 h-11 rounded-full object-cover shrink-0"
                />
                <div>
                  <p class="text-ink font-bold font-display leading-tight">
                    {review.name}
                  </p>
                  <p class="text-sm text-slate-500">{review.role}</p>
                  <p class="text-[11px] text-gray-500 mt-0.5 uppercase tracking-wider font-mono">
                    {review.course}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div
        class="hidden md:flex md:items-center md:flex-row-reverse md:gap-3 md:absolute md:-top-16 md:right-0"
      >
        <button
          type="button"
          data-scroll-next
          aria-label="Наступні відгуки"
          class="slider-arrow"
        >
          <Arrow />
        </button>
        <button
          type="button"
          data-scroll-prev
          aria-label="Попередні відгуки"
          class="slider-arrow slider-arrow--prev"
        >
          <Arrow />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-scroll {
    scrollbar-width: none;
    scroll-padding-left: 1rem;
  }
  .reviews-scroll::-webkit-scrollbar {
    display: none;
  }
  @media (pointer: fine) {
    .reviews-scroll {
      cursor: grab;
    }
    .reviews-scroll.is-grabbing {
      cursor: grabbing;
      scroll-snap-type: none;
    }
  }
  .slider-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #1f2937;
    color: #fff;
    transition: background 0.15s ease;
  }
  .slider-arrow:hover {
    background: #273549;
  }
  .slider-arrow--prev {
    transform: rotate(180deg);
  }
</style>

<script>
  const section = document.getElementById("reviews");
  const scroller = section?.querySelector<HTMLElement>("[data-scroller]");
  if (section && scroller) {
    const step = () => {
      const card = scroller.querySelector<HTMLElement>(":scope > article");
      return card ? card.offsetWidth + 24 : scroller.clientWidth * 0.8;
    };
    section
      .querySelector("[data-scroll-next]")
      ?.addEventListener("click", () =>
        scroller.scrollBy({ left: step(), behavior: "smooth" }),
      );
    section
      .querySelector("[data-scroll-prev]")
      ?.addEventListener("click", () =>
        scroller.scrollBy({ left: -step(), behavior: "smooth" }),
      );

    // mouse drag-to-scroll (touch keeps native swipe)
    let down = false,
      sx = 0,
      sl = 0,
      moved = false;
    scroller.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true;
      moved = false;
      sx = e.clientX;
      sl = scroller.scrollLeft;
      scroller.classList.add("is-grabbing");
    });
    scroller.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 4) moved = true;
      scroller.scrollLeft = sl - dx;
    });
    const endDrag = () => {
      down = false;
      scroller.classList.remove("is-grabbing");
    };
    scroller.addEventListener("pointerup", endDrag);
    scroller.addEventListener("pointerleave", endDrag);
    scroller.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
  }
</script>

<style>
  .ic-logo {
    --ic-cyan: var(--color-neon-cyan, #22d3ee);
    --ic-text: var(--color-ink, #e6eef9);
    --ic-name-size: 26px;
  }

  .ic-name {
    font-family: "Outfit", "Inter", sans-serif;
    font-size: var(--ic-name-size);
    font-weight: 900;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .ic-name-prefix {
    color: var(--ic-cyan);
    text-shadow: 0 0 18px rgba(34, 211, 238, 0.45);
    color: #22d3ee;
  }

  .ic-name-base {
    color: var(--ic-text);
  }

  .ic-name-accent {
    color: rgba(255, 255, 255, 0.35);
    font-weight: 300;
    letter-spacing: -0.03em;
  }
</style>
