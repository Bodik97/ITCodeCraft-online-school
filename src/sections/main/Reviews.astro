---
import content from "@/data/main.json";
import Arrow from "@/icons/arrow.svg";

const reviewBorders = [
  "border-l-neon-cyan",
  "border-l-neon-magenta",
  "border-l-neon-orange",
] as const;

const highlightReviewText = (text: string, highlight: string): string =>
  text.replace(
    highlight,
    `<span class="text-neon-cyan font-bold not-italic">${highlight}</span>`,
  );

const brandPrimary = content.brand.primary ?? "ITCode";
const brandAccent = content.brand.accent ?? "Craft";
const brandPrefix = brandPrimary.startsWith("IT")
  ? "IT"
  : brandPrimary.slice(0, 2);
const brandBase = brandPrimary.slice(brandPrefix.length);
---

<section
  id="reviews"
  class="py-24 bg-paper border-t border-slate-200/70 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class=" mb-16">
      <h2 class="text-xl  md:text-2xl font-bold font-display text-ink mb-4 xl:text-4xl">
        {content.reviewsSection.titlePrefix}
        <span class=""
          >
          <span class="ic-name">
            <span class="ic-name-prefix ">{brandPrefix}</span
            ><span class="ic-name-base ">{brandBase}</span><span
              class="ic-name-accent">{brandAccent}</span
            >
          </span>
        </span>
      </h2>
    </div>

    <div class="swiper reviews__slider">
      <div class="swiper-wrapper">
        {
          content.reviewsSection.reviews.map((review, index) => (
            <article
              class:list={[
                "swiper-slide bg-surface min-h-[300px] p-8 rounded-sm border-l-4 group hover:bg-surface-light transition-colors duration-300 flex flex-col h-full",
                reviewBorders[index % reviewBorders.length],
              ]}
            >
              <div
                class="text-ink/15 font-display text-5xl leading-none mb-3"
                aria-hidden="true"
              >
                "
              </div>

              <p
                class="text-slate-600 leading-relaxed mb-6 flex-1"
                set:html={`${highlightReviewText(review.text, review.highlight)}`}
              />

              <div class="flex items-center gap-3 border-t border-slate-200/70 pt-4 mt-auto">
                <img
                  src={`./assets/reviews/${review.img}.webp`}
                  alt={review.name}
                  width="44"
                  height="44"
                  class="w-11 h-11 rounded-full object-cover shrink-0"
                />
                <div>
                  <p class="text-ink font-bold font-display leading-tight">
                    {review.name}
                  </p>
                  <p class="text-sm text-slate-500">{review.role}</p>
                  <p class="text-[11px] text-gray-500 mt-0.5 uppercase tracking-wider font-mono">
                    {review.course}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="swiper-pagination"></div>
      <div
        class="hidden xl:flex xl:items-center xl:flex-row-reverse xl:gap-4 xl:absolute xl:-top-20 xl:right-0"
      >
        <div class="swiper-button-next">
          <Arrow />
        </div>
        <div class="swiper-button-prev">
          <Arrow />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews__slider {
    overflow: visible;
  }

</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";

  const root = document.querySelector<HTMLElement>(".reviews__slider");
  if (root) {
    const bulletColors = ["#22d3ee", "#f43f5e", "#84cc16"];
    const styleBullets = () => {
      root
        .querySelectorAll<HTMLElement>(".swiper-pagination-bullet")
        .forEach((b, i) => {
          b.style.background = bulletColors[i % bulletColors.length];
        });
    };

    new Swiper(root, {
      modules: [Navigation, Pagination],
      slidesPerView: 1.1,
      spaceBetween: 16,
      grabCursor: true,
      navigation: {
        nextEl: root.querySelector<HTMLElement>(".swiper-button-next"),
        prevEl: root.querySelector<HTMLElement>(".swiper-button-prev"),
      },
      pagination: {
        el: root.querySelector<HTMLElement>(".swiper-pagination"),
        clickable: true,
      },
      breakpoints: {
        768: { slidesPerView: 2, spaceBetween: 16 },
        1280: { slidesPerView: 3, spaceBetween: 24 },
      },
      on: {
        init: () => requestAnimationFrame(styleBullets),
        paginationRender: () => requestAnimationFrame(styleBullets),
        breakpoint: () => requestAnimationFrame(styleBullets),
      },
    });
  }
</script>

<style>
  .ic-logo {
    --ic-cyan: var(--color-neon-cyan, #22d3ee);
    --ic-text: var(--color-ink, #e6eef9);
    --ic-name-size: 26px;
  }

  .ic-name {
    font-family: "Outfit", "Inter", sans-serif;
    font-size: var(--ic-name-size);
    font-weight: 900;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .ic-name-prefix {
    color: var(--ic-cyan);
    text-shadow: 0 0 18px rgba(34, 211, 238, 0.45);
    color: #22d3ee;
  }

  .ic-name-base {
    color: var(--ic-text);
  }

  .ic-name-accent {
    color: rgba(255, 255, 255, 0.35);
    font-weight: 300;
    letter-spacing: -0.03em;
  }
</style>
