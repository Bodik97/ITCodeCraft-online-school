---
import content from "@/data/main.json";
import HeroScene from "@/components/main/hero/HeroScene";
import { Icon } from "astro-icon/components";

const section = content.hero;
const getInitialCounterValue = (rawValue: string): string => {
  const suffix = rawValue.replace(/[\d.]/g, "");
  return `0${suffix}`;
};

const heroTypingStyles = [
  "text-neon-lime text-glow-lime",
  "text-neon-cyan text-glow-cyan",
  "text-neon-orange text-glow-orange",
] as const;

const heroStatColors = [
  "text-neon-magenta",
  "text-neon-lime",
  "text-neon-orange",
] as const;
---

<section
  id="hero-section"
  class="hero-shell relative overflow-x-hidden pt-28 pb-20 md:pt-36 md:pb-28"
>
  <div class="hero-shell-glow" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="grid items-center gap-10 lg:gap-12 xl:gap-16"
    >
      <!-- LEFT: content -->
      <div class="hero-content relative z-20">
        <h1
          class="hero-headline hero-enter font-display text-3xl font-bold leading-tight text-ink md:text-4xl xl:max-w-230 xl:text-5xl 2xl:text-6xl 2xl:max-w-300"
          style="--hero-delay: 0.08s"
        >
          {section.liveBadgePrefix}
        </h1>

        <p
          class="hero-subtitle hero-enter mt-4 max-w-xl text-sm text-slate-500 md:text-lg lg:max-w-130 xl:max-w-160 2xl:text-xl 2xl:max-w-180"
          style="--hero-delay: 0.18s"
        >
          {section.subtitle}
        </p>

        <div
          class="hero-enter mt-6"
          style="--hero-delay: 0.28s"
        >
          <div
            id="hero-typing"
            aria-live="polite"
            class="relative h-[3.3em] overflow-hidden text-base md:h-[3.4em] md:text-lg lg:w-141.25 2xl:text-lg 2xl:w-160"
          >
            {
              section.typingTexts.map((text, index) => (
                <div
                  class:list={[
                    "hero-typing-item absolute left-0 right-0 w-full text-lg font-semibold md:text-2xl",
                    heroTypingStyles[index % heroTypingStyles.length],
                    index === 0 && "is-active",
                  ]}
                >
                  {text}
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="hero-enter mt-6 flex flex-wrap gap-2"
          style="--hero-delay: 0.38s"
        >
          {
            section.options.map((option) => (
              <span class="hero-option rounded-full border border-neon-cyan/25 bg-neon-cyan/10 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-slate-600">
                {option}
              </span>
            ))
          }
        </div>

        <div
          class="hero-enter mt-8 flex flex-wrap items-center gap-4 lg:flex-col lg:items-start 2xl:flex-row 2xl:items-center 2xl:gap-6"
          style="--hero-delay: 0.48s"
        >
          <button
            type="button"
            data-modal-open
            class="hero-cta group inline-flex items-center gap-2 rounded-2xl bg-neon-cyan px-7 py-4 text-base font-bold text-[#062a31] shadow-[0_12px_28px_-12px_rgba(8,145,178,0.65)] transition-[transform,box-shadow,background-color] duration-300 hover:-translate-y-0.5 hover:bg-[#67e8f9] hover:shadow-[0_16px_34px_-12px_rgba(8,145,178,0.75)]"
          >
            {section.ctaPrimary}
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true">→</span
            >
          </button>
          <p class="text-sm font-medium text-slate-500">{section.ctaNote}</p>
        </div>
      </div>

      <!-- RIGHT: interactive scene -->
      <div
        class="hero-enter relative z-10 lg:absolute lg:right-0 lg:top-16 lg:h-full lg:w-1/2 2xl:-right-35"
        style="--hero-delay: 0.2s"
      >
        <HeroScene client:load />
      </div>
    </div>

    <!-- Stats -->
    <div
      class="hero-enter hero-stats-border mt-14 grid max-w-4xl grid-cols-1 gap-8 border-t border-slate-700 pt-8 sm:mx-auto sm:grid-cols-3"
      style="--hero-delay: 0.55s"
    >
      {
        section.stats.map((stat, index) => (
          <div class="flex flex-col items-center">
            <div
              class:list={[
                "mb-2 flex items-center gap-2",
                heroStatColors[index % heroStatColors.length],
              ]}
            >
              <span class="text-xl" aria-hidden="true">
                <Icon name={stat.icon} class="size-7" />
              </span>
              <span
                class="hero-counter font-display text-3xl font-bold"
                data-target={stat.value}
              >
                {getInitialCounterValue(stat.value)}
              </span>
            </div>
            <span class="text-sm text-slate-500">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <!-- SEO paragraph -->
    <div
      class="hero-enter mx-auto mt-12 max-w-3xl text-center md:text-left lg:text-center"
      style="--hero-delay: 0.65s"
    >
      <p class="text-lg leading-relaxed text-slate-500">
        <strong class="text-ink"
          >{content.brand.primary}{content.brand.accent}</strong
        >
        {section.seoLead}
        <span class="text-neon-lime"> {section.seoMinecraft}</span>, {
          section.seoMiddle
        }
        <span class="text-neon-cyan"> {section.seoRoblox}</span>, {
          section.seoTail
        }
        <span class="text-neon-orange"> {section.seoWebsites}.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    background: linear-gradient(
      to bottom,
      var(--color-paper) 0%,
      var(--color-paper) 62%,
      color-mix(in srgb, var(--color-paper) 72%, transparent) 78%,
      color-mix(in srgb, var(--color-paper) 28%, transparent) 90%,
      transparent 100%
    );
  }

  .hero-shell-glow {
    pointer-events: none;
    position: absolute;
    inset: -20% -10% auto;
    height: 70%;
    background:
      radial-gradient(
        55% 60% at 18% 30%,
        rgba(34, 211, 238, 0.14),
        transparent 70%
      ),
      radial-gradient(
        45% 50% at 82% 25%,
        rgba(132, 204, 22, 0.1),
        transparent 72%
      ),
      radial-gradient(
        40% 45% at 55% 80%,
        rgba(245, 158, 11, 0.08),
        transparent 70%
      );
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }

  .hero-enter {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.65, 0.3, 1),
      transform 0.7s cubic-bezier(0.2, 0.65, 0.3, 1),
      filter 0.7s cubic-bezier(0.2, 0.65, 0.3, 1);
    transition-delay: var(--hero-delay, 0s);
  }

  .hero-enter.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .hero-headline {
    letter-spacing: -0.02em;
  }

  .hero-cta:focus-visible {
    outline: 2px solid #0891b2;
    outline-offset: 3px;
  }

  :global(html.light) .hero-shell {
    background: linear-gradient(
      to bottom,
      #f8f9fc 0%,
      #f8f9fc 58%,
      rgba(248, 249, 252, 0.75) 76%,
      rgba(244, 247, 252, 0.28) 90%,
      transparent 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }

    .hero-shell-glow {
      opacity: 0.5;
    }
  }
</style>

<script>
  const heroSection = document.getElementById("hero-section");

  if (heroSection) {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const reveals = heroSection.querySelectorAll(".hero-enter");
    if (prefersReduced) {
      reveals.forEach((el) => el.classList.add("is-visible"));
    } else {
      requestAnimationFrame(() => {
        reveals.forEach((el) => el.classList.add("is-visible"));
      });
    }

    const counters = heroSection.querySelectorAll<HTMLElement>(".hero-counter");
    const DURATION = 1800;
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    const animateCounter = (el: HTMLElement) => {
      const raw = el.dataset.target || "";
      const suffix = raw.replace(/[\d.]/g, "");
      const target = parseFloat(raw);
      if (isNaN(target)) return;

      const isFloat = raw.includes(".");
      const decimals = isFloat
        ? raw.split(".")[1]?.replace(/[^\d]/g, "").length || 1
        : 0;
      const start = performance.now();

      el.textContent = isFloat ? (0).toFixed(decimals) + suffix : "0" + suffix;

      const step = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / DURATION, 1);
        const current = target * easeOutCubic(progress);

        el.textContent =
          (isFloat
            ? current.toFixed(decimals)
            : Math.floor(current).toString()) + suffix;

        if (progress < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    };

    if (prefersReduced) {
      counters.forEach((el) => {
        el.textContent = el.dataset.target || "";
      });
    } else {
      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setTimeout(
                () => animateCounter(entry.target as HTMLElement),
                700,
              );
              counterObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );
      counters.forEach((el) => counterObserver.observe(el));
    }
  }
</script>
